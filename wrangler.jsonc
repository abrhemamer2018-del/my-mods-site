// إعدادات النشر على Cloudflare
{
  "name": "ibrahimalobaidimods",
  "compatibility_date": "2026-09-30",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_REPO": "abrhemamer2018-del/my-mods-site",
    "GITHUB_BRANCH": "main"
  },
  "observability": { "enabled": true }
}
