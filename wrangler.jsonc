// إعدادات النشر على Cloudflare
{
  "name": "ibrahimalobaidimods",
  "compatibility_date": "2026-09-30",
  "main": "./worker/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_REPO": "abrhemamer2018-del/my-mods-site",
    "GITHUB_BRANCH": "main"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
