// إعدادات النشر على Cloudflare
{
  "name": "ibrahimalobaidimods",
  "compatibility_date": "2026-09-30",
  "main": "./worker/index.js",
  "workers_dev": false,
  // لا تحذف المتغيرات المضافة من لوحة Cloudflare عند كل نشر من GitHub
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // حد محاولات تسجيل الدخول: 5 محاولات في الدقيقة لكل IP
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    // حد بلاغات المشاكل من الزوار: 3 بلاغات في الدقيقة لكل IP
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "vars": {
    "GITHUB_REPO": "abrhemamer2018-del/my-mods-site",
    // مستودع ملفات التعريب (GitHub Releases)، في حساب منفصل
    "FILES_REPO": "abrhemamer2017-debug/files",
    "GITHUB_BRANCH": "main",
    // بوت ديسكورد "تعريبات" (المفتاح العام ليس سراً؛ التوكن DISCORD_BOT_TOKEN سر في Cloudflare)
    "DISCORD_APP_ID": "1564569249974845490",
    "DISCORD_PUBLIC_KEY": "c5863627343a38ca8b2a2d2399377153e04b4ed8f8a254bbb1a708ad9827c217",
    "DISCORD_REQUESTS_FORUM": "1556915194775601212",
    // صاحب السيرفر: يُمنشن في قناة التنبيهات الخاصة بالطلبات التي تدخل قائمة المراجعة
    "DISCORD_OWNER_ID": "419033682968444930",
    "DISCORD_ALERTS_CHANNEL": "1564738883072032808",
    // روم مخفي: سطر لكل طلب منشور، ومنه يعرف البوت حد طلب واحد في الأسبوع
    "DISCORD_REQUESTS_LOG": "1565214121727627316"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
