---
import { NAV, SITE, SOCIAL } from '../config';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <a href="/" class="name">{SITE.name}</a>
      <p class="muted">{SITE.description}</p>
    </div>
    <nav class="links" aria-label="روابط">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="social">
      <span class="follow">تابعنا</span>
      {
        SOCIAL.map((s) => (
          <a href={s.url} aria-label={s.label} title={s.label} target="_blank" rel="noopener">
            <Icon name={s.icon} />
          </a>
        ))
      }
    </div>
  </div>
  <div class="container copy muted">
    © {year} {SITE.name}. جميع ملفات التعريب مجانية. الألعاب وأسماؤها ملك لأصحابها.
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: 64px;
    background: var(--bg-2);
    padding-block: 40px 24px;
  }
  /* خط متدرج رفيع بألوان الشعار يفصل المحتوى عن الفوتر */
  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-2), var(--accent), transparent 85%);
  }
  .inner {
    display: grid;
    grid-template-columns: 2fr 1fr auto;
    gap: 32px;
    align-items: start;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
  }
  .about p {
    max-width: 50ch;
    margin: 8px 0 0;
  }
  .links {
    display: grid;
    gap: 6px;
  }
  .links a,
  .social a {
    color: var(--muted);
  }
  .links a:hover,
  .social a:hover {
    color: var(--accent);
  }
  .social {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .follow {
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 700;
    margin-inline-end: 4px;
  }
  .copy {
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid rgb(255 255 255 / 0.05);
    font-size: 0.85rem;
  }
  @media (max-width: 700px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
