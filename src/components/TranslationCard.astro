---
import { Image } from 'astro:assets';
import { STATUS_LABELS } from '../config';
import { formatMonth, isNew, type Translation } from '../lib/utils';

interface Props {
  item: Translation;
  hidden?: boolean;
  /** عدد التحميلات (من GitHub وقت البناء) */
  downloads?: number;
  /** تصنيفات القسم مفصولة بـ | لأزرار التصفية في الرئيسية */
  cats?: string;
}
const { item, hidden, downloads = 0, cats = '' } = Astro.props;
const d = item.data;
const fresh = await isNew(item);
// المنصة وحجم ملف التعريب، مثل "PC · 15.09 MB"
const size = d.downloads[0]?.size;
// "محدّث": آخر نسخة غير الأولى وصدرت خلال 30 يوماً
const last = [...d.changelog].sort((a, b) => b.date.getTime() - a.date.getTime())[0];
const updated = !!last && d.changelog.length > 1 && Date.now() - last.date.getTime() < 30 * 86400000;
const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
---

<a
  href={`/translations/${item.id}/`}
  class="card"
  hidden={hidden}
  data-cats={cats}
  data-category={d.category}
  data-status={d.status}
  data-platforms={d.platforms.join('|')}
  data-search={`${d.title} ${d.titleAr}`.toLowerCase()}
>
  {/* هالة متساوية بلون الغلاف: الغلاف مصغّر إلى بكسل واحد = متوسط ألوانه كلها (ملف صغير جداً) */}
  <Image class="glow" src={d.cover} alt="" width={1} height={1} loading="lazy" aria-hidden="true" />
  <div class="card-in">
  <div class="thumb">
    <Image src={d.cover} alt={`تعريب لعبة ${d.titleAr} (${d.title})`} width={480} height={270} />
    <div class="badges">
      {fresh && <span class="badge badge-new">جديد</span>}
      {!fresh && updated && <span class="badge badge-upd" dir="ltr">محدّث · v{d.version}</span>}
      {d.status !== 'complete' && (
        <span class="badge badge-warn">
          {STATUS_LABELS[d.status]}
          {d.progress !== undefined && ` ${d.progress}%`}
        </span>
      )}
    </div>
  </div>
  <div class="body">
    <h3 class="title-en" dir="ltr">{d.title}</h3>
    <p class="title-ar">{d.titleAr}</p>
    <div class="meta">
      {downloads > 0 ? (
        <span class="dls">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg>
          <b dir="ltr">{compact.format(downloads)}</b> تحميل
        </span>
      ) : (
        <span>{formatMonth(d.releaseDate)}</span>
      )}
      <span dir="ltr" class="spec">
        {d.platforms.join(', ')}
        {size && <> · {size}</>}
      </span>
    </div>
  </div>
  </div>
</a>

<style>
  .dls {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .dls svg {
    color: var(--accent);
  }
  .dls b {
    color: var(--text);
  }
  .badge-upd {
    background: rgb(25 195 214 / 0.9);
    color: #0b0d17;
  }
  /* البطاقة طبقتان: الخارجية تحمل الهالة خلفها، والداخلية (card-in) هي البطاقة المرئية */
  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s;
  }
  .card-in {
    flex: 1;
    display: flex;
    flex-direction: column;
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 12px;
    background:
      linear-gradient(var(--card), var(--card)) padding-box,
      linear-gradient(var(--border), var(--border)) border-box;
  }
  /* عند مرور الفأرة: إطار بتدرج الشعار + هالة بألوان الغلاف (مثل التعريبات المثبتة لكن عند التفاعل فقط) */
  .card:hover {
    z-index: 2; /* فوق البطاقات المجاورة حتى تظهر الهالة */
    transform: translateY(-5px);
  }
  .card:hover .card-in {
    background:
      linear-gradient(var(--card-hover), var(--card-hover)) padding-box,
      conic-gradient(from 210deg, var(--accent), #8b95ff, var(--accent-2), var(--accent)) border-box;
  }
  .card :global(.glow) {
    position: absolute;
    inset: 26% 3% -8%;
    width: 94%;
    height: 82%;
    object-fit: fill;
    border-radius: 40%;
    filter: blur(30px) saturate(1.8) brightness(1.1);
    opacity: 0;
    z-index: -1;
    pointer-events: none;
    transition:
      opacity 0.35s,
      transform 0.35s;
  }
  .card:hover :global(.glow) {
    opacity: 0.28;
    transform: translateY(6px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
  .thumb {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .card:hover .thumb :global(img) {
    transform: scale(1.05);
  }
  .badges {
    position: absolute;
    top: 8px;
    inset-inline-start: 8px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .body {
    padding: 14px 6px 4px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .title-en {
    font-family: var(--font);
    font-size: 1.05rem;
    font-weight: 800;
    margin: 0;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .title-ar {
    color: var(--muted);
    margin: 2px 0 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .meta {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2px 8px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .spec {
    font-weight: 700;
    color: #c9cde6;
  }
  /* الجوال: بطاقتان في كل صف، فنصغّر المسافات والخطوط */
  @media (max-width: 560px) {
    .card-in {
      padding: 8px;
      border-radius: 14px;
    }
    .thumb {
      border-radius: 9px;
    }
    .badges {
      top: 6px;
      inset-inline-start: 6px;
    }
    .body {
      padding: 10px 2px 2px;
    }
    .title-en {
      font-size: 0.9rem;
    }
    .title-ar {
      font-size: 0.85rem;
      margin-bottom: 10px;
    }
    .meta {
      font-size: 0.72rem;
    }
  }
</style>
