---
import { Image } from 'astro:assets';
import { STATUS_LABELS } from '../config';
import { formatMonth, isNew, type Translation } from '../lib/utils';

interface Props {
  item: Translation;
  hidden?: boolean;
}
const { item, hidden } = Astro.props;
const d = item.data;
const fresh = await isNew(item);
// المنصة وحجم ملف التعريب، مثل "PC · 15.09 MB"
const size = d.downloads[0]?.size;
---

<a
  href={`/translations/${item.id}/`}
  class="card"
  hidden={hidden}
  data-category={d.category}
  data-status={d.status}
  data-platforms={d.platforms.join('|')}
  data-search={`${d.title} ${d.titleAr}`.toLowerCase()}
>
  {/* هالة ضوء بألوان الغلاف تظهر عند مرور الفأرة (نفس الصورة المحمّلة، فلا تحميل إضافي) */}
  <Image class="glow" src={d.cover} alt="" width={480} height={270} aria-hidden="true" />
  <div class="card-in">
  <div class="thumb">
    <Image src={d.cover} alt={`تعريب لعبة ${d.titleAr} (${d.title})`} width={480} height={270} />
    <div class="badges">
      {fresh && <span class="badge badge-new">جديد</span>}
      {d.status !== 'complete' && (
        <span class="badge badge-warn">
          {STATUS_LABELS[d.status]}
          {d.progress !== undefined && ` ${d.progress}%`}
        </span>
      )}
    </div>
  </div>
  <div class="body">
    <h3 class="title-en" dir="ltr">{d.title}</h3>
    <p class="title-ar">{d.titleAr}</p>
    <div class="meta">
      <span>{formatMonth(d.releaseDate)}</span>
      <span dir="ltr" class="spec">
        {d.platforms.join(', ')}
        {size && <> · {size}</>}
      </span>
    </div>
  </div>
  </div>
</a>

<style>
  /* البطاقة طبقتان: الخارجية تحمل الهالة خلفها، والداخلية (card-in) هي البطاقة المرئية */
  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s;
  }
  .card-in {
    flex: 1;
    display: flex;
    flex-direction: column;
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 12px;
    background:
      linear-gradient(var(--card), var(--card)) padding-box,
      linear-gradient(var(--border), var(--border)) border-box;
  }
  /* عند مرور الفأرة: إطار بتدرج الشعار + هالة بألوان الغلاف (مثل التعريبات المثبتة لكن عند التفاعل فقط) */
  .card:hover {
    z-index: 2; /* فوق البطاقات المجاورة حتى تظهر الهالة */
    transform: translateY(-5px);
  }
  .card:hover .card-in {
    background:
      linear-gradient(var(--card-hover), var(--card-hover)) padding-box,
      conic-gradient(from 210deg, var(--accent), #8b95ff, var(--accent-2), var(--accent)) border-box;
  }
  .card :global(.glow) {
    position: absolute;
    inset: 24% -5% -18%;
    width: 110%;
    height: 94%;
    object-fit: cover;
    border-radius: var(--radius);
    filter: blur(32px) saturate(2) brightness(1.15);
    opacity: 0;
    z-index: -1;
    pointer-events: none;
    transition:
      opacity 0.35s,
      transform 0.35s;
  }
  .card:hover :global(.glow) {
    opacity: 1;
    transform: translateY(10px) scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
  .thumb {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .card:hover .thumb :global(img) {
    transform: scale(1.05);
  }
  .badges {
    position: absolute;
    top: 8px;
    inset-inline-start: 8px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .body {
    padding: 14px 6px 4px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .title-en {
    font-family: var(--font);
    font-size: 1.05rem;
    font-weight: 800;
    margin: 0;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .title-ar {
    color: var(--muted);
    margin: 2px 0 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .meta {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2px 8px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .spec {
    font-weight: 700;
    color: #c9cde6;
  }
  /* الجوال: بطاقتان في كل صف، فنصغّر المسافات والخطوط */
  @media (max-width: 560px) {
    .card-in {
      padding: 8px;
      border-radius: 14px;
    }
    .thumb {
      border-radius: 9px;
    }
    .badges {
      top: 6px;
      inset-inline-start: 6px;
    }
    .body {
      padding: 10px 2px 2px;
    }
    .title-en {
      font-size: 0.9rem;
    }
    .title-ar {
      font-size: 0.85rem;
      margin-bottom: 10px;
    }
    .meta {
      font-size: 0.72rem;
    }
  }
</style>
