---
import { Image } from 'astro:assets';
import type { Translation } from '../lib/utils';

interface Props {
  items: Translation[];
}
const { items } = Astro.props;
const multi = items.length > 1;
// نسخة من الشريحة الأولى في النهاية حتى يبدو التنقل دائرياً بلا قفزة
const slides = multi ? [...items, items[0]] : items;
---

<section class="hero" aria-roledescription="carousel" aria-label="تعريبات مميزة" data-count={items.length}>
  <div class="track">
    {
      slides.map((item, i) => (
        <div class="slide" aria-hidden={i !== 0 ? 'true' : undefined} data-clone={i === items.length ? '' : undefined}>
          {/* خلفية: نفس الصورة مكبّرة ومموّهة لتملأ الفراغات بألوانها */}
          <Image
            class="bg"
            src={item.data.banner ?? item.data.cover}
            alt=""
            width={480}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          {/* الصورة كاملة بدون قص */}
          <Image
            class="fg"
            src={item.data.banner ?? item.data.cover}
            alt=""
            width={1920}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <div class="content container">
            <h2 class="title" dir="ltr">{item.data.title}</h2>
            <p class="ar">{item.data.titleAr}</p>
            <p class="summary">{item.data.summary}</p>
            <a href={`/translations/${item.id}/`} class="btn" tabindex={i !== 0 ? -1 : undefined}>
              صفحة التعريب
            </a>
          </div>
        </div>
      ))
    }
  </div>

  {
    multi && (
      <>
        <button class="arrow prev" aria-label="السابق">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
        </button>
        <button class="arrow next" aria-label="التالي">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <div class="dots">
          {items.map((_, i) => (
            <button class:list={['dot', { active: i === 0 }]} aria-label={`الشريحة ${i + 1}`} data-i={i}>
              <span />
            </button>
          ))}
        </div>
      </>
    )
  }
</section>

<style>
  .hero {
    --duration: 5s;
    position: relative;
    height: clamp(400px, 64vh, 640px);
    overflow: hidden;
    margin-top: -76px; /* يمتد تحت الهيدر الشفاف */
    touch-action: pan-y;
  }
  .track {
    display: flex;
    height: 100%;
    direction: ltr;
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }
  .track.no-anim {
    transition: none;
  }
  .slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    direction: rtl;
  }
  /* الخلفية المموّهة: تأخذ ألوانها من صورة البانر نفسها */
  .slide :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(48px) saturate(1.4) brightness(0.65);
    transform: scale(1.3);
  }
  /* حركة بطيئة للخلفية أثناء عرض الشريحة */
  .slide.current :global(.bg) {
    animation: drift 9s ease-out forwards;
  }
  @keyframes drift {
    from {
      transform: scale(1.45) translateX(2%);
    }
    to {
      transform: scale(1.3) translateX(0);
    }
  }
  /* الصورة كاملة بكل تفاصيلها، تبدأ تحت الهيدر */
  .slide :global(.fg) {
    position: absolute;
    inset: 76px 0 0;
    width: 100%;
    height: calc(100% - 76px);
    object-fit: contain;
    filter: drop-shadow(0 12px 40px rgb(0 0 0 / 0.5));
  }
  /* تظليل خفيف أسفل الشريحة فقط حتى يبقى النص مقروءاً */
  .slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--bg) 0%, rgb(11 13 23 / 0.55) 28%, transparent 60%),
      radial-gradient(ellipse at center, transparent 55%, rgb(11 13 23 / 0.35) 100%);
  }
  .content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-bottom: 72px;
  }
  .slide .content > * {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  .slide.current .content > * {
    opacity: 1;
    transform: none;
  }
  .slide.current .content > :nth-child(2) {
    transition-delay: 0.1s;
  }
  .slide.current .content > :nth-child(3) {
    transition-delay: 0.2s;
  }
  .slide.current .content > :nth-child(4) {
    transition-delay: 0.3s;
  }
  .title {
    font-size: clamp(2rem, 6vw, 4rem);
    margin: 0;
    text-shadow: 0 4px 24px rgb(0 0 0 / 0.6);
    letter-spacing: 0.02em;
  }
  .ar {
    font-family: var(--font-display);
    color: var(--accent);
    font-size: 1.3rem;
    margin: 0;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.85);
  }
  .summary {
    max-width: 60ch;
    margin: 8px auto 20px;
    color: #d6d9ee;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .content .btn {
    backdrop-filter: blur(6px);
  }

  .arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.15);
    background: rgb(11 13 23 / 0.45);
    backdrop-filter: blur(8px);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.3s,
      background 0.2s,
      border-color 0.2s;
  }
  .hero:hover .arrow,
  .arrow:focus-visible {
    opacity: 1;
  }
  .arrow:hover {
    background: rgb(25 195 214 / 0.35);
    border-color: var(--accent);
  }
  .prev {
    right: 24px;
  }
  .next {
    left: 24px;
  }

  .dots {
    position: absolute;
    z-index: 3;
    bottom: 26px;
    inset-inline: 0;
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  .dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 0;
    padding: 0;
    background: rgb(255 255 255 / 0.3);
    cursor: pointer;
    overflow: hidden;
    transition:
      width 0.4s,
      background 0.3s;
  }
  .dot.active {
    width: 44px;
  }
  /* شريط التقدم داخل النقطة النشطة */
  .dot span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
  }
  .dot.active span {
    animation: progress var(--duration) linear forwards;
  }
  .hero.paused .dot.active span {
    animation-play-state: paused;
  }
  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 700px) {
    .arrow {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      transition: none;
    }
    .slide.current :global(.bg) {
      animation: none;
      transform: scale(1.3);
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const count = Number(hero?.dataset.count || 0);

  if (hero && count > 1) {
    const track = hero.querySelector<HTMLElement>('.track')!;
    const slides = [...hero.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('.dot')];
    const DURATION = 5000;
    let index = 0;
    let timer: number | undefined;
    let paused = false;

    const mark = (i: number) => {
      const real = i % count;
      slides.forEach((s, n) => {
        const on = n === i;
        s.classList.toggle('current', on);
        s.toggleAttribute('aria-hidden', !on);
        s.querySelector('a')?.setAttribute('tabindex', on ? '0' : '-1');
      });
      dots.forEach((d, n) => {
        d.classList.remove('active');
        if (n === real) {
          void d.offsetWidth; // إعادة تشغيل شريط التقدم
          d.classList.add('active');
        }
      });
    };

    const go = (i: number, animate = true) => {
      track.classList.toggle('no-anim', !animate);
      index = i;
      track.style.transform = `translateX(-${index * 100}%)`;
      mark(index);
    };

    // بعد الوصول للنسخة المكررة نعود للأولى بدون حركة
    track.addEventListener('transitionend', () => {
      if (index === count) go(0, false);
    });

    const next = () => {
      if (index === count) go(0, false);
      requestAnimationFrame(() => go(index + 1));
    };
    const prev = () => {
      if (index === 0) {
        go(count, false);
        requestAnimationFrame(() => requestAnimationFrame(() => go(count - 1)));
      } else go(index - 1);
    };

    const stop = () => clearInterval(timer);
    const start = () => {
      stop();
      if (!paused && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        timer = window.setInterval(next, DURATION);
      }
    };
    const restart = () => {
      start();
      mark(index);
    };

    hero.querySelector('.next')?.addEventListener('click', () => (next(), restart()));
    hero.querySelector('.prev')?.addEventListener('click', () => (prev(), restart()));
    dots.forEach((d) =>
      d.addEventListener('click', () => {
        go(Number(d.dataset.i));
        restart();
      }),
    );

    // إيقاف مؤقت عند مرور الفأرة أو إخفاء الصفحة
    const setPaused = (p: boolean) => {
      paused = p;
      hero.classList.toggle('paused', p);
      p ? stop() : restart();
    };
    hero.addEventListener('mouseenter', () => setPaused(true));
    hero.addEventListener('mouseleave', () => setPaused(false));
    document.addEventListener('visibilitychange', () => setPaused(document.hidden));

    // السحب باللمس على الجوال
    let x0: number | null = null;
    hero.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    hero.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      x0 = null;
      if (Math.abs(dx) < 40) return;
      dx < 0 ? next() : prev();
      restart();
    });

    go(0, false);
    start();
  } else if (hero) {
    hero.querySelector('.slide')?.classList.add('current');
  }
</script>
