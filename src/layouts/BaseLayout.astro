---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DonateButton from '../components/DonateButton.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string; // صورة المشاركة في تويتر وديسكورد
}

// الصورة الافتراضية للمشاركة (public/og.png) للصفحات التي ليس لها صورة خاصة
const { title, description = SITE.description, image = '/og.png' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang={SITE.lang} dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b0d17" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ar_AR" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Reem+Kufi:wght@500;700&family=Tajawal:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <DonateButton />

    <button type="button" class="to-top" id="to-top" aria-label="العودة إلى الأعلى" hidden>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6" /></svg>
    </button>

    <script is:inline>
      // يُفعّل تأثير الظهور الناعم فقط إذا كان JavaScript يعمل، حتى لا تبقى العناصر مخفية بدونه
      document.documentElement.classList.add('js');
    </script>
    <script>
      // ظهور ناعم للبطاقات والأقسام عند الوصول إليها بالتمرير
      const targets = document.querySelectorAll<HTMLElement>(
        '.card, .step, .stats-strip, .discord-band, .panel, .block, .article, .item',
      );
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              io.unobserve(e.target);
              const el = e.target as HTMLElement;
              el.classList.add('in');
              // بعد اكتمال الظهور نزيل التأثير حتى تعود حركة العنصر الأصلية (مثل رفع البطاقة عند مرور الفأرة)
              setTimeout(() => {
                el.classList.remove('reveal', 'in');
                el.style.transitionDelay = '';
              }, 900);
            }
          },
          { rootMargin: '0px 0px -40px 0px' },
        );
        targets.forEach((el, i) => {
          el.classList.add('reveal');
          // تدرّج بسيط بين العناصر المتجاورة
          el.style.transitionDelay = `${(i % 5) * 60}ms`;
          io.observe(el);
        });
      }

      // زر "العودة للأعلى" يظهر بعد النزول في الصفحة
      const toTop = document.getElementById('to-top')!;
      const toggleTop = () => (toTop.hidden = window.scrollY < 600);
      toggleTop();
      window.addEventListener('scroll', toggleTop, { passive: true });
      toTop.addEventListener('click', () => window.scrollTo({ top: 0 }));
    </script>

    <script>
      // تحويل التواريخ إلى صيغة "منذ يومين" في المتصفح حتى تبقى دقيقة دائماً
      const rtf = new Intl.RelativeTimeFormat('ar', { numeric: 'auto' });
      document.querySelectorAll<HTMLTimeElement>('time[data-ago]').forEach((el) => {
        const days = Math.round((new Date(el.dateTime).getTime() - Date.now()) / 86400000);
        let text;
        if (Math.abs(days) < 30) text = rtf.format(days, 'day');
        else if (Math.abs(days) < 365) text = rtf.format(Math.round(days / 30), 'month');
        else text = rtf.format(Math.round(days / 365), 'year');
        el.textContent = (el.dataset.ago || '') + text;
      });
    </script>
    <!-- عدّاد الزوار (Cloudflare Web Analytics) يضيفه Cloudflare تلقائياً، فلا تضفه هنا حتى لا تُحسب الزيارة مرتين -->
  </body>
</html>

<style>
  /* زر العودة للأعلى: أسفل اليمين (زر "ادعمنا" في اليسار) */
  .to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 40;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--accent);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .to-top:hover {
    border-color: var(--accent);
    background: var(--card-hover);
    transform: translateY(-2px);
  }
  @media (max-width: 600px) {
    .to-top {
      bottom: 16px;
      right: 16px;
      width: 44px;
      height: 44px;
    }
  }
</style>
