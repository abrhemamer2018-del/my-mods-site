  /* المحتوى تحت: عمود واحد بعرض الصفحة */
  .layout {
    grid-template-columns: minmax(0, 1fr);
    padding-top: 30px;
  }
  /* ═════ طريقة التثبيت: مسار من 4 محطات متصلة، وتحته النصيحة والملاحظة متجاورتان ═════ */
  .prose {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'h h'
      'ol ol'
      'tip nh'
      'tip np'
      'tip nu';
    column-gap: 18px;
  }
  .prose > :global(h2:first-of-type) {
    grid-area: h;
    margin: 0 0 16px;
  }
  .prose > :global(ol) {
    grid-area: ol;
  }
  .prose > :global(ol + p) {
    grid-area: tip;
  }
  .prose > :global(h2:nth-of-type(2)) {
    grid-area: nh;
  }
  .prose > :global(h2:nth-of-type(2) ~ p) {
    grid-area: np;
  }
  .prose > :global(h2:nth-of-type(2) ~ ul) {
    grid-area: nu;
  }
  .prose :global(h2:first-of-type + ol) {
    counter-reset: step;
    list-style: none;
    position: relative;
    margin: 0 0 18px;
    padding: 30px 20px 28px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(25 195 214 / 0.09), transparent 60%),
      radial-gradient(60% 120% at 0% 100%, rgb(224 52 79 / 0.08), transparent 60%),
      var(--card);
  }
  /* الخط الذي يمر بالمحطات الأربع */
  .prose :global(h2:first-of-type + ol)::before {
    content: '';
    position: absolute;
    top: 53px;
    right: 12.5%;
    left: 12.5%;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-2), var(--accent));
    opacity: 0.55;
  }
  .prose :global(h2:first-of-type + ol > li) {
    counter-increment: step;
