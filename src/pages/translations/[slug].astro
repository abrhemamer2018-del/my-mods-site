---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import TranslationCard from '../../components/TranslationCard.astro';
import { downloadsOf } from '../../lib/downloads';
import { getTranslations, formatDate, relatedTranslations, youtubeId, type Translation } from '../../lib/utils';
import { CATEGORY_LABELS, SITE, STATUS_LABELS } from '../../config';

export async function getStaticPaths() {
  const all = await getTranslations();
  return all.map((t) => ({ params: { slug: t.id }, props: { item: t } }));
}

const { item } = Astro.props as { item: Translation };
const d = item.data;
const { Content } = await render(item);
const og = await getImage({ src: d.banner ?? d.cover, width: 1200, format: 'jpg' });
const shots = await Promise.all(
  d.screenshots.map(async (s) => ({ thumb: s, full: (await getImage({ src: s, width: 1600 })).src })),
);
// عارض الصور أعلى الصفحة: الغلاف ثم لقطات التعريب
const media = [{ thumb: d.cover, full: (await getImage({ src: d.cover, width: 1600 })).src }, ...shots];
// فيديو يوتيوب اختياري: لا يظهر القسم إذا لم يوضع رابط
const videoId = youtubeId(d.video);
// وصف نتائج Google: يبدأ بذكر التعريب ثم نبذة اللعبة
// محركات البحث تعرض نحو 160 حرفاً فقط، فنقصّ عند آخر كلمة كاملة قبل الحد
const SEO_MAX = 158;
const seoFull = `تعريب عربي كامل ومجاني للعبة ${d.title} (${d.titleAr}) مع أداة تثبيت سهلة. ${d.summary}`
  .replace(/\s+/g, ' ')
  .trim();
const seoDescription =
  seoFull.length <= SEO_MAX ? seoFull : seoFull.slice(0, seoFull.lastIndexOf(' ', SEO_MAX - 1)).replace(/[،,.:؛\s]+$/, '') + '…';

// "تعريبات أخرى قد تعجبك": نفس السلسلة أولاً ثم الألعاب المشابهة في وسوم Steam (relatedTranslations في utils)
const RELATED_COUNT = 4;
const all = await getTranslations();
// عنوان الصفحة بالصيغ التي يبحث بها الناس: "تعريب لعبة X بالعربي ... تحميل مجاني"
const hasArabicName = /[؀-ۿ]/.test(d.titleAr) && d.titleAr.trim() !== d.title.trim();
const pageTitle = `تعريب لعبة ${d.title} بالعربي${hasArabicName ? ` (${d.titleAr})` : ''} — تحميل مجاني`;

// أسئلة شائعة: تظهر في الصفحة، وتفهمها محركات البحث (FAQPage) فقد تعرضها تحت النتيجة
const faq = [
  {
    q: `هل تعريب ${d.title} مجاني؟`,
    a: `نعم، تعريب ${d.titleAr} مجاني بالكامل، ويمكنك تحميله مباشرة من هذه الصفحة دون تسجيل.`,
  },
  {
    q: 'هل يعمل التعريب مع نسخة Steam و Epic و GOG؟',
    a: 'نعم، التعريب يعمل على نسخة الكمبيوتر (PC) الأصلية من اللعبة، وأداة التثبيت تجد مجلد اللعبة تلقائياً في Steam أو Epic أو GOG.',
  },
  ...(d.gameVersion
    ? [{ q: 'ما نسخة اللعبة المدعومة؟', a: `التعريب مُختبَر على نسخة اللعبة ${d.gameVersion}. إن كانت نسختك أقدم فحدّث اللعبة أولاً.` }]
    : []),
  {
    q: `كيف أثبّت تعريب ${d.title}؟`,
    a: 'حمّل الملف وفك ضغطه، ثم أغلق اللعبة وشغّل أداة التثبيت واضغط "تثبيت". بعدها شغّل اللعبة وستظهر بالعربية مباشرة.',
  },
  {
    q: 'ظهرت رسالة "Windows protected your PC"، فهل الملف آمن؟',
    a: 'هذه رسالة طبيعية تظهر مع البرامج الصغيرة غير الموقّعة. اضغط More info ثم Run anyway لتشغيل أداة التثبيت.',
  },
  {
    q: 'كيف أحذف التعريب وأعيد اللعبة كما كانت؟',
    a: 'من Steam: كلك يمين على اللعبة ← Properties ← Installed Files ← Verify integrity of game files، فتعود ملفات اللعبة الأصلية.',
  },
];

// البيانات المنظمة (schema.org): التعريب كبرنامج مجاني للعبة، ومسار الصفحة، والأسئلة الشائعة
const pageUrl = new URL(`/translations/${item.id}/`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: `تعريب ${d.title} إلى العربية`,
    alternateName: [`${d.title} Arabic Translation`, ...d.aliases.map((a) => `تعريب ${a}`)],
    description: seoDescription,
    url: pageUrl,
    image: new URL(og.src, Astro.site).href,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Windows',
    inLanguage: 'ar',
    softwareVersion: d.version,
    datePublished: d.releaseDate.toISOString().slice(0, 10),
    ...(d.updatedDate ? { dateModified: d.updatedDate.toISOString().slice(0, 10) } : {}),
    ...(d.downloads[0]?.size ? { fileSize: d.downloads[0].size } : {}),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    ...(d.team[0] ? { author: { '@type': 'Person', name: d.team[0].name } } : {}),
    about: {
      '@type': 'VideoGame',
      name: d.title,
      alternateName: [...(hasArabicName ? [d.titleAr] : []), ...d.aliases],
      gamePlatform: d.platforms,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'التعريبات', item: new URL('/translations/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: `تعريب ${d.title}`, item: pageUrl },
    ],
  },
];

const related = relatedTranslations(item, all, RELATED_COUNT);
const relatedDl = await Promise.all(related.map((t) => downloadsOf(t)));
---

<BaseLayout fullTitle={pageTitle} description={seoDescription} image={og.src} jsonLd={jsonLd}>
  {/* أعلى الصفحة بأسلوب صفحة متجر: العنوان، ثم عارض صور كبير، وبجانبه صندوق التحميل والمعلومات */}
  <section class="sp" data-pagefind-body>
    <Image class="sp-bg" src={d.banner ?? d.cover} alt="" aria-hidden="true" width={1920} height={600} loading="eager" />
    <div class="container sp-in">
      <nav class="crumbs" aria-label="مسار الصفحة">
        <a href="/">الرئيسية</a>
        <span aria-hidden="true">‹</span>
        <a href="/translations/">التعريبات</a>
        <span aria-hidden="true">‹</span>
        <span dir="ltr">{d.title}</span>
      </nav>
      <div class="sp-head">
        <h1>
          <span class="kicker">تعريب لعبة</span>
          <span class="game-title" dir="ltr">{d.title}</span>
        </h1>
        <p class="ar">{d.titleAr}</p>
        {d.aliases.length > 0 && <p class="aliases">يُعرف أيضاً باسم: {d.aliases.join('، ')}</p>}
      </div>

      <div class="sp-grid">
        {/* عارض الصور: الغلاف ثم لقطات التعريب */}
        <div class="viewer">
          <a href={media[0].full} class="vw-main" aria-label="تكبير الصورة">
            <Image src={d.cover} alt={`تعريب لعبة ${d.titleAr} (${d.title})`} width={1200} height={675} loading="eager" />
          </a>
          {
            media.length > 1 && (
              <div class="vw-thumbs">
                {media.map((m, i) => (
                  <a href={m.full} class:list={['shot', { on: i === 0 }]} data-index={i}>
                    <Image src={m.thumb} alt={i === 0 ? `غلاف تعريب ${d.titleAr}` : `لقطة ${i} من تعريب ${d.titleAr}`} width={240} />
                  </a>
                ))}
              </div>
            )
          }
        </div>

        {/* صندوق التحميل: كل ما يحتاجه الزائر قبل التحميل في مكان واحد */}
        <aside class="buy" id="download">
          <div class="tags">
            <span class="badge">{CATEGORY_LABELS[d.category]}</span>
            <span class:list={['badge', d.status === 'complete' ? 'badge-green' : 'badge-warn']}>{STATUS_LABELS[d.status]}</span>
          </div>
          <p class="summary">{d.summary}</p>
          {
            d.status !== 'complete' && d.progress !== undefined && (
              <div class="progress" role="progressbar" aria-valuenow={d.progress} aria-valuemin="0" aria-valuemax="100">
                <div style={`width:${d.progress}%`} />
                <span>نسبة الإنجاز {d.progress}%</span>
              </div>
            )
          }
          {/* المعلومات بطاقات صغيرة (العنوان فوق والقيمة تحت)، وبطاقة الإصدار تفتح سجل التحديثات */}
          <div class="tiles">
            {
              d.changelog.length > 1 ? (
                <button type="button" class="tile tile-ver" id="cl-open" aria-haspopup="dialog">
                  <span class="t-label">إصدار التعريب</span>
                  <span class="t-row">
                    <span class="t-val" dir="ltr">v{d.version}</span>
                    <span class="t-more">سجل التحديثات ‹</span>
                  </span>
                </button>
              ) : (
                <div class="tile">
                  <span class="t-label">إصدار التعريب</span>
                  <span class="t-val" dir="ltr">v{d.version}</span>
                </div>
              )
            }
            <div class="tile">
              <span class="t-label">المنصة</span>
              <span class="t-val" dir="ltr">{d.platforms.join(', ')}</span>
            </div>
            {
              d.gameVersion && (
                <div class="tile">
                  <span class="t-label">نسخة اللعبة</span>
                  <span class="t-val" dir="ltr">{d.gameVersion}</span>
                </div>
              )
            }
            <div class="tile">
              <span class="t-label">{d.updatedDate ? 'آخر تحديث' : 'تاريخ الإصدار'}</span>
              <span class="t-val">{formatDate(d.updatedDate ?? d.releaseDate)}</span>
            </div>
            {d.team.map((m) => (
              <div class="tile">
                <span class="t-label">{m.role}</span>
                <span class="t-val">{m.name}</span>
              </div>
            ))}
          </div>
          <div class="buy-cta">
            {
              d.downloads.length ? (
                d.downloads.map((dl) => (
                  <a href={dl.url} class="btn btn-primary buy-dl" target="_blank" rel="noopener">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg>
                    <span>تحميل مجاني</span>
                    {dl.size && <small dir="ltr">{dl.size}</small>}
                  </a>
                ))
              ) : (
                <p class="muted">روابط التحميل ستتوفر قريباً.</p>
              )
            }
            <p class="legal muted">
              <span>نحثّك على دعم المطوّر وشراء اللعبة</span>
              <span class="sep" aria-hidden="true">·</span>
              <a href="/copyright/">حقوق النشر</a>
            </p>
          </div>
          <button type="button" class="buy-report" id="report-open">
            <span aria-hidden="true">⚠️</span> لم يعمل التعريب معك؟ <b>أبلغنا</b>
          </button>
        </aside>
      </div>
      <p class="en-line" lang="en" dir="ltr">Arabic translation mod for {d.title} — free download for PC.</p>
    </div>
  </section>

  <div class="container layout">
    <article class="main" data-pagefind-body>
      <div class="prose" id="install">
        {/* رابط هادئ في سطر عنوان "طريقة التثبيت" يفتح طريقة حذف التعريب */}
        <button type="button" class="un-open" id="un-open" aria-haspopup="dialog">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
          طريقة حذف التعريب
        </button>
        <Content />
      </div>

      {
        videoId && (
          <section class="block" data-pagefind-ignore>
            <h2>فيديو التعريب</h2>
            {/* صورة الفيديو وزر التشغيل أولاً، ومشغّل يوتيوب يُحمَّل عند الضغط فقط حتى تبقى الصفحة سريعة */}
            <a
              href={`https://www.youtube.com/watch?v=${videoId}`}
              class="yt"
              data-id={videoId}
              target="_blank"
              rel="noopener"
              aria-label={`تشغيل فيديو تعريب ${d.titleAr}`}
            >
              <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt={`فيديو تعريب ${d.titleAr}`} loading="lazy" />
              <span class="play" aria-hidden="true">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </span>
            </a>
          </section>
        )
      }

      {
        d.requirements.length > 0 && (
          <section class="block">
            <h2>المتطلبات</h2>
            <ul class="plain">
              {d.requirements.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </section>
        )
      }

    </article>

  </div>

  {
    related.length > 0 && (
      <section class="container related" data-pagefind-ignore>
        <div class="section-head">
          <h2>تعريبات أخرى قد تعجبك</h2>
          <a href="/translations/" class="more-pill">كل التعريبات ‹</a>
        </div>
        <div class="related-cards">
          {related.map((t, i) => <TranslationCard item={t} downloads={relatedDl[i]} />)}
        </div>
      </section>
    )
  }

  {
    media.length > 0 && (
      <dialog class="lightbox" aria-label={`صور تعريب ${d.titleAr}`}>
        <img class="lb-img" alt="صورة مكبّرة من التعريب" />
        <button class="lb-btn lb-close" aria-label="إغلاق">
          <Icon name="close" size={24} />
        </button>
        {media.length > 1 && (
          <>
            <button class="lb-btn lb-prev" aria-label="الصورة السابقة">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
            </button>
            <button class="lb-btn lb-next" aria-label="الصورة التالية">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
            </button>
          </>
        )}
        <span class="lb-count" dir="ltr" />
      </dialog>
    )
  }
  {
    d.changelog.length > 1 && (
      <dialog class="cl-box" id="cl-box" aria-labelledby="cl-title">
        <div class="cl-in" tabindex="-1" autofocus>
          <div class="cl-top">
            <h2 id="cl-title">سجل التحديثات</h2>
            <button type="button" class="cl-x" id="cl-close" aria-label="إغلاق">✕</button>
          </div>
          <p class="muted cl-sub">تعريب {d.titleAr} · النسخة الحالية <span dir="ltr">v{d.version}</span></p>
          <ol class="changelog">
            {[...d.changelog]
              .sort((x, y) => y.date.getTime() - x.date.getTime())
              .map((c, i) => (
                <li class:list={{ now: i === 0 }}>
                  <div class="cl-head">
                    <strong dir="ltr">v{c.version}</strong>
                    {i === 0 && <span class="cl-now">الحالية</span>}
                    <time class="muted" datetime={c.date.toISOString()}>{formatDate(c.date)}</time>
                  </div>
                  <ul>
                    {c.notes.map((n) => (
                      <li>{n}</li>
                    ))}
                  </ul>
                </li>
              ))}
          </ol>
        </div>
      </dialog>
    )
  }
  <dialog class="cl-box un-box" id="un-box" aria-labelledby="un-title">
    <div class="cl-in" tabindex="-1" autofocus>
      <div class="cl-top">
        <h2 id="un-title">حذف التعريب</h2>
        <button type="button" class="cl-x" id="un-close" aria-label="إغلاق">✕</button>
      </div>
      <p class="muted cl-sub">لإرجاع اللعبة كما كانت قبل التعريب:</p>
      <ol class="un-steps">
        <li>في <bdi>Steam</bdi> كلك يمين على اللعبة واختر <bdi>Properties</bdi>.</li>
        <li>افتح <bdi>Installed Files</bdi>.</li>
        <li>اضغط <bdi>Verify integrity of game files</bdi>، فتعود ملفات اللعبة الأصلية.</li>
      </ol>
    </div>
  </dialog>
  <dialog class="report-box" id="report-box" aria-labelledby="report-title">
    <form id="report-form" class="report-form" novalidate>
      <div class="rf-head">
        <h2 id="report-title">الإبلاغ عن مشكلة</h2>
        <button type="button" class="rf-close" id="report-close" aria-label="إغلاق">✕</button>
      </div>
      <p class="muted rf-sub">تعريب {d.titleAr} ({d.title}) · الإصدار v{d.version}</p>

      <input type="hidden" name="slug" value={item.id} />
      <input type="hidden" name="version" value={d.version} />
      <!-- حقل مخفي للحماية من الروبوتات -->
      <input type="text" name="website" class="rf-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <label>
        نوع المشكلة *
        <select name="type" required>
          <option value="">اختر...</option>
          <option value="not-showing">التعريب لا يظهر في اللعبة</option>
          <option value="game-crash">اللعبة لا تعمل أو تتوقف</option>
          <option value="installer">مشكلة في أداة التثبيت</option>
          <option value="text">نص ناقص أو خطأ في الترجمة</option>
          <option value="other">أخرى</option>
        </select>
      </label>
      <label>
        من أين اشتريت اللعبة؟
        <select name="store">
          <option>Steam</option>
          <option>Epic</option>
          <option>GOG</option>
          <option>Xbox / Game Pass</option>
          <option>أخرى</option>
        </select>
      </label>
      <label>
        وصف المشكلة *
        <textarea name="text" rows="4" required minlength="10" maxlength="1500" placeholder="ماذا حدث بالضبط؟ مثلاً: ثبّتُّ التعريب لكن القوائم ما زالت بالإنجليزي."></textarea>
      </label>
      <label>
        للتواصل معك (اختياري)
        <input name="contact" maxlength="100" placeholder="اسمك في ديسكورد أو حسابك في إكس" />
      </label>

      <div class="rf-actions">
        <button type="submit" class="btn btn-primary">إرسال البلاغ</button>
        <span class="rf-status" id="report-status" role="status"></span>
      </div>
      <p class="muted rf-alt">
        تفضّل المتابعة مباشرة؟{" "}
        <a href={SITE.reportDiscordUrl} target="_blank" rel="noopener">اكتب في قناة #الإبلاغ-عن-مشكلة في ديسكورد</a>
      </p>
    </form>
  </dialog>
</BaseLayout>

<style>
  .banner {
    position: relative;
    margin-top: -76px;
    padding: 140px 0 48px;
    overflow: hidden;
  }
  .banner :global(.banner-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(6px) brightness(0.5);
    transform: scale(1.1);
  }
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--bg), rgb(11 13 23 / 0.4));
  }
  .banner-content {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 36px;
    align-items: center;
  }
  .banner-content :global(.cover) {
    width: min(420px, 40%);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border: 1px solid rgb(255 255 255 / 0.1);
  }
  .tags {
    display: flex;
    gap: 8px;
  }
  h1 {
    margin: 10px 0 0;
    text-align: right;
  }
  /* سطر صغير "تعريب لعبة" فوق اسم اللعبة: يكمل العنوان لمحركات البحث */
  h1 .kicker {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 2px;
  }
  h1 .game-title {
    display: block;
    font-size: clamp(1.8rem, 4.5vw, 3rem);
  }
  .ar {
    font-family: var(--font-display);
    color: var(--accent);
    font-size: 1.3rem;
    margin: 0;
  }
  .aliases {
    color: #aeb3cf;
    font-size: 0.9rem;
    margin: 2px 0 0;
  }
  .summary {
    color: #d6d9ee;
    max-width: 60ch;
  }
  .progress {
    position: relative;
    height: 28px;
    background: var(--bg-2);
    border-radius: 999px;
    overflow: hidden;
    max-width: 420px;
    border: 1px solid var(--border);
  }
