  }
  .report-open {
    width: 100%;
    padding: 10px;
    font: inherit;
    font-weight: 700;
    color: #ff8a9c;
    background: rgb(224 52 79 / 0.08);
    border: 1px solid rgb(224 52 79 / 0.35);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .report-open:hover {
    background: rgb(224 52 79 / 0.16);
    border-color: var(--accent-2);
  }
  .report-box {
    width: min(520px, calc(100vw - 32px));
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--text);
  }
  .report-box::backdrop {
    background: rgb(5 6 12 / 0.8);
    backdrop-filter: blur(4px);
  }
  .report-form {
    display: grid;
