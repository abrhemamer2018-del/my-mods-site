  }
  .yt {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #000;
  }
  .yt img,
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .yt img {
    transition: transform 0.4s, filter 0.3s;
    filter: brightness(0.8);
  }
  .yt:hover img {
    transform: scale(1.03);
    filter: brightness(0.65);
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 76px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    background: #e0242b;
    color: #fff;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.45);
    transition: transform 0.2s;
  }
