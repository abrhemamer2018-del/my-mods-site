  .related {
    padding-block: 48px 72px;
  }
  .related-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 1000px) {
    .related-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .related-cards {
      gap: 12px;
    }
  }

  /* عارض الصور داخل الموقع */
  .lightbox {
    width: calc(100vw / var(--zoom));
    height: calc(100dvh / var(--zoom));
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: rgb(5 6 12 / 0.92);
    backdrop-filter: blur(6px);
  }
  .lb-img {
    max-width: calc(100vw / var(--zoom) - 160px);
    max-height: calc(100dvh / var(--zoom) - 120px);
    border-radius: 12px;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
    user-select: none;
  }
  .lb-btn {
    position: fixed;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.15);
    background: rgb(20 23 40 / 0.75);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .lb-btn:hover {
    background: rgb(25 195 214 / 0.35);
    border-color: var(--accent);
  }
  .lb-close {
    top: 20px;
    left: 20px;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    right: 24px;
  }
  .lb-next {
    left: 24px;
  }
  .lb-count {
    position: fixed;
    bottom: 22px;
    left: 0;
    right: 0;
    text-align: center;
    color: #c9cde6;
    font-weight: 700;
