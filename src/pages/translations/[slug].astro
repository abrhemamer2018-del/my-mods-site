<script>
  // تشغيل فيديو يوتيوب داخل الصفحة عند الضغط (بدل فتحه في تبويب جديد)
  document.querySelectorAll<HTMLAnchorElement>('.yt[data-id]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1&rel=0`;
      frame.title = el.getAttribute('aria-label') || 'YouTube';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      el.replaceChildren(frame);
      el.removeAttribute('href');
    });
  });
</script>

<script>
  // عارض الصور: يفتح الصورة كبيرة داخل الموقع بدل فتحها في نافذة جديدة
  const box = document.querySelector<HTMLDialogElement>('.lightbox');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.vw-thumbs .shot, .vw-main')].filter(
    (a, i, all) => !(a.classList.contains('vw-main') && all.length > 1),
  );
  if (box && links.length) {
    const img = box.querySelector<HTMLImageElement>('.lb-img')!;
    const count = box.querySelector<HTMLElement>('.lb-count')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      img.src = links[current].href;
      img.alt = links[current].querySelector('img')?.alt || '';
      count.textContent = links.length > 1 ? `${current + 1} / ${links.length}` : '';
    };
    const open = (i: number) => {
      show(i);
      box.showModal();
      document.documentElement.style.overflow = 'hidden';
    };

    // الصور المصغّرة تغيّر الصورة الكبيرة، والضغط على الكبيرة يفتحها في العارض
    const main = document.querySelector<HTMLAnchorElement>('.vw-main')!;
    const mainImg = main.querySelector('img')!;
    let picked = 0;
    links.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        if (a === main) return open(0);
        picked = i;
        mainImg.src = a.dataset.big || a.href;
        mainImg.removeAttribute('srcset');
        links.forEach((x) => x.classList.toggle('on', x === a));
      }),
    );
    if (links.length > 1)
      main.addEventListener('click', (e) => {
        e.preventDefault();
        open(picked);
      });
    box.addEventListener('close', () => (document.documentElement.style.overflow = ''));
    box.querySelector('.lb-close')?.addEventListener('click', () => box.close());
    box.querySelector('.lb-next')?.addEventListener('click', () => show(current + 1));
    box.querySelector('.lb-prev')?.addEventListener('click', () => show(current - 1));
    // الضغط خارج الصورة يغلق العارض
    box.addEventListener('click', (e) => {
      if (e.target === box) box.close();
    });
    // الأسهم في لوحة المفاتيح (الصفحة من اليمين لليسار: السهم الأيسر = التالي)
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current + 1);
      if (e.key === 'ArrowRight') show(current - 1);
    });
    // السحب باللمس على الجوال
    let x0: number | null = null;
    box.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    box.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>

<script>
  // نافذة طريقة حذف التعريب
  const un = document.getElementById('un-box') as HTMLDialogElement | null;
  if (un) {
    document.getElementById('un-open')?.addEventListener('click', () => un.showModal());
    document.getElementById('un-close')?.addEventListener('click', () => un.close());
    un.addEventListener('click', (e) => {
      if (e.target === un) un.close();
    });
  }
  // نافذة سجل التحديثات
  const cl = document.getElementById('cl-box') as HTMLDialogElement | null;
  if (cl) {
    document.getElementById('cl-open')?.addEventListener('click', () => cl.showModal());
    document.getElementById('cl-close')?.addEventListener('click', () => cl.close());
    cl.addEventListener('click', (e) => {
      if (e.target === cl) cl.close();
    });
  }
</script>

<script>
  // نموذج الإبلاغ عن مشكلة: يرسل إلى /api/report فيصل البلاغ لقناة ديسكورد
  const box = document.getElementById('report-box') as HTMLDialogElement | null;
  const form = document.getElementById('report-form') as HTMLFormElement | null;
  const status = document.getElementById('report-status');
  if (box && form && status) {
    document.getElementById('report-open')?.addEventListener('click', () => box.showModal());
    document.getElementById('report-close')?.addEventListener('click', () => box.close());
    box.addEventListener('click', (e) => {
      if (e.target === box) box.close();
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (!data.type) return void (status.textContent = 'اختر نوع المشكلة'), status.classList.add('err');
      if ((data.text || '').trim().length < 10) {
        status.className = 'rf-status err';
        status.textContent = 'اكتب وصفاً أوضح للمشكلة';
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      status.className = 'rf-status';
      status.textContent = 'جارٍ الإرسال...';
      try {
        const res = await fetch('/api/report', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(out.error || 'تعذّر الإرسال');
        status.className = 'rf-status ok';
        status.textContent = '✅ وصل بلاغك، شكراً لك! سنراجعه قريباً.';
        form.reset();
        setTimeout(() => box.close(), 2500);
      } catch (ex) {
        status.className = 'rf-status err';
        status.textContent = (ex as Error).message;
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
