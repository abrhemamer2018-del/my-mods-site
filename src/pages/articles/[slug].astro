---
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles, formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((a) => ({ params: { slug: a.id }, props: { item: a } }));
}

const { item } = Astro.props as { item: CollectionEntry<'articles'> };
const d = item.data;
const { Content } = await render(item);
const og = d.cover ? (await getImage({ src: d.cover, width: 1200, format: 'jpg' })).src : undefined;
const back = d.kind === 'lesson' ? { href: '/lessons/', label: 'الدروس' } : { href: '/articles/', label: 'المقالات' };
// البيانات المنظمة (schema.org): مقال ومسار الصفحة، تفهمها محركات البحث
const pageUrl = new URL(`/articles/${item.id}/`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    inLanguage: 'ar',
    mainEntityOfPage: pageUrl,
    image: new URL(og ?? '/og.png', Astro.site).href,
    author: { '@type': 'Organization', name: 'تعريبات', url: new URL('/', Astro.site).href },
    publisher: { '@type': 'Organization', name: 'تعريبات', url: new URL('/', Astro.site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: back.label, item: new URL(back.href, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={d.title} description={d.description} image={og} jsonLd={jsonLd}>
  <article class="container section wrap" data-pagefind-body>
    <a href={back.href} class="muted back">› {back.label}</a>
    <h1>{d.title}</h1>
    <p class="muted meta">
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
      {d.tags.length > 0 && <span> · {d.tags.join('، ')}</span>}
    </p>
    {d.cover && <Image src={d.cover} alt={d.title} width={1000} class="cover" loading="eager" />}
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .wrap {
    max-width: 860px;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-top: 12px;
  }
  .meta {
    margin-top: -8px;
  }
  .wrap :global(.cover) {
    width: 100%;
    border-radius: var(--radius);
    margin: 20px 0;
  }
</style>
