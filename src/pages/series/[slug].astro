---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TranslationCard from '../../components/TranslationCard.astro';
import { getTranslations, seriesOf, SERIES } from '../../lib/utils';
import { downloadsOf } from '../../lib/downloads';

// صفحة لكل سلسلة: تجمع كل أجزائها المعرّبة، للبحث بصيغة "تعريب سلسلة ياكوزا"
export async function getStaticPaths() {
  const all = await getTranslations();
  return SERIES.map((s) => ({
    params: { slug: s.slug },
    props: { s, items: all.filter((t) => seriesOf(t)?.slug === s.slug) },
  })).filter((p) => p.props.items.length >= 2);
}

const { s, items: unsorted } = Astro.props;
// الأجزاء بترتيب صدورها على الكمبيوتر
const when = (t: (typeof unsorted)[number]) => (t.data.gameRelease ?? t.data.releaseDate).getTime();
const items = [...unsorted].sort((a, b) => when(a) - when(b));
const dl = await Promise.all(items.map((t) => downloadsOf(t)));

const title = `تعريب سلسلة ${s.ar} (${s.en}) بالعربي — كل الأجزاء تحميل مجاني`;
const description = `كل تعريبات سلسلة ${s.en} (${s.ar}) في مكان واحد: ${items.length} أجزاء معرّبة بالكامل ومجاناً مع أداة تثبيت سهلة لنسخة الكمبيوتر.`;
const pageUrl = new URL(`/series/${s.slug}/`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: pageUrl,
    inLanguage: 'ar',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: items.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `تعريب ${t.data.title}`,
        url: new URL(`/translations/${t.id}/`, Astro.site).href,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'التعريبات', item: new URL('/translations/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: `سلسلة ${s.ar}`, item: pageUrl },
    ],
  },
];
---

<BaseLayout fullTitle={title} description={description} jsonLd={jsonLd}>
  <div class="container section" data-pagefind-body>
    <a href="/translations/" class="muted back">› التعريبات</a>
    <h1 class="page-title">تعريب سلسلة {s.ar}</h1>
    <p class="muted intro">
      كل أجزاء سلسلة <bdi>{s.en}</bdi> المعرّبة إلى العربية ({items.length} أجزاء)، مرتبة حسب صدورها على الكمبيوتر. كل تعريب
      مجاني ويأتي مع أداة تثبيت تجد اللعبة تلقائياً في Steam أو Epic أو GOG.
    </p>
    <div class="cards">
      {items.map((t, i) => <TranslationCard item={t} downloads={dl[i]} />)}
    </div>
    <p class="muted foot">
      لا تعرف كيف تثبّت التعريب؟ اقرأ <a href="/articles/how-to-install-arabic-translation/">طريقة التثبيت خطوة بخطوة</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .back:hover,
  .foot a {
    color: var(--accent);
  }
  .intro {
    max-width: 820px;
    margin-bottom: 24px;
    line-height: 1.9;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
  }
  /* الجوال: بطاقتان في كل صف */
  @media (max-width: 560px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
  .foot {
    margin-top: 28px;
  }
</style>
