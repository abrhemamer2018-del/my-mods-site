---
// قالب منشورات فيسبوك وإنستغرام: يملأ النص والصورة تلقائياً من بيانات أي تعريب في الموقع
// الصفحة لا تحتاج تسجيل دخول لأنها لا تعدّل شيئاً (كل بياناتها منشورة أصلاً)، ومخفية عن محركات البحث
import '../../styles/global.css';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE, SOCIAL } from '../../config';

const SITE_URL = 'https://ta3reebat.com';
const all = (await getCollection('translations', (t) => !t.data.draft)).sort(
  (a, b) => +(b.data.addedAt ?? b.data.releaseDate) - +(a.data.addedAt ?? a.data.releaseDate),
);
const games = await Promise.all(
  all.map(async (t) => {
    const d = t.data;
    const img = await getImage({ src: d.banner ?? d.cover, width: 1200, format: 'jpg' });
    const last = d.changelog[0];
    return {
      id: t.id,
      title: d.title.replace(/[™®]/g, '').replace(/\s+/g, ' ').trim(),
      titleAr: d.titleAr,
      aliases: d.aliases,
      summary: d.summary,
      status: d.status,
      progress: d.progress ?? null,
      version: d.version,
      gameVersion: d.gameVersion ?? '',
      notes: last?.notes ?? [],
      img: img.src,
      url: `${SITE_URL}/translations/${t.id}/`,
    };
  }),
);
const discord = SOCIAL.find((s) => s.icon === 'discord')?.url ?? '';
const config = { games, discord, site: SITE_URL, siteName: SITE.name };
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>قالب المنشورات | {SITE.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Reem+Kufi:wght@500;700&family=Tajawal:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <div class="container bar">
        <a href="/admin/" class="brand"><img src="/logo.svg" alt="" width="36" height="36" /> قالب منشورات فيسبوك وإنستغرام</a>
        <div class="bar-actions">
          <a href="/admin/" class="btn small">← لوحة التحكم</a>
        </div>
      </div>
    </header>

    <main class="container sp">
      <section class="sp-card sp-opts">
        <label class="sp-field sp-game">
          <span>اللعبة</span>
          <input id="q" type="search" list="games" placeholder="اكتب اسم اللعبة بالعربي أو الإنجليزي…" autocomplete="off" />
          <datalist id="games"></datalist>
        </label>
        <div class="sp-field">
          <span>نوع المنشور</span>
          <div class="sp-seg" id="kind">
            <button type="button" data-v="new" class="on">🎮 تعريب جديد</button>
            <button type="button" data-v="update">🔄 تحديث</button>
          </div>
        </div>
        <div class="sp-field">
          <span>المنصة</span>
          <div class="sp-seg" id="platform">
            <button type="button" data-v="fb" class="on">فيسبوك</button>
            <button type="button" data-v="ig">إنستغرام</button>
          </div>
        </div>
      </section>

      <p id="empty" class="sp-empty">اختر لعبة من القائمة لتظهر المنشور والصورة.</p>

      <section id="out" class="sp-out" hidden>
        <div class="sp-card">
          <div class="sp-head">
            <h2>نص المنشور</h2>
            <span class="muted small" id="count"></span>
          </div>
          <textarea id="text" rows="18" dir="rtl"></textarea>
          <div class="sp-actions">
            <button type="button" id="post" class="btn btn-primary"></button>
            <button type="button" id="copy" class="btn">📋 نسخ النص</button>
            <a id="open" class="btn" target="_blank" rel="noopener">صفحة التعريب ↗</a>
          </div>
          <p class="muted small" id="hint"></p>
        </div>
        <div class="sp-card">
          <div class="sp-head">
            <h2>الصورة</h2>
            <span class="muted small" id="size"></span>
          </div>
          <canvas id="cv"></canvas>
          <div class="sp-actions">
            <button type="button" id="dl" class="btn btn-primary">⬇️ تحميل الصورة</button>
          </div>
        </div>
      </section>
    </main>

    <script is:inline type="application/json" id="data" set:html={JSON.stringify(config)} />

    <script>
      type Game = {
        id: string; title: string; titleAr: string; aliases: string[]; summary: string;
        status: 'complete' | 'beta' | 'in-progress'; progress: number | null;
        version: string; gameVersion: string; notes: string[]; img: string; url: string;
      };
      const cfg = JSON.parse(document.getElementById('data')!.textContent!) as {
        games: Game[]; discord: string; site: string; siteName: string;
      };
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const q = $<HTMLInputElement>('q');
      const text = $<HTMLTextAreaElement>('text');
      const cv = $<HTMLCanvasElement>('cv');
      const label = (g: Game) => `${g.titleAr} — ${g.title}`;
      $('games').innerHTML = cfg.games.map((g) => `<option value="${label(g).replace(/"/g, '&quot;')}"></option>`).join('');

      const state = { kind: 'new', platform: 'fb', game: null as Game | null };
      for (const id of ['kind', 'platform'] as const) {
        $(id).addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest('button');
          if (!b) return;
          $(id).querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
          state[id] = b.dataset.v!;
          render();
        });
      }

      const norm = (s: string) => s.toLowerCase().replace(/[™®:'’\-]/g, '').replace(/\s+/g, ' ').trim();
      const find = (v: string) => {
        const n = norm(v);
        if (!n) return null;
        return (
          cfg.games.find((g) => norm(label(g)) === n) ??
          cfg.games.find((g) => [g.title, g.titleAr, ...g.aliases].some((x) => norm(x) === n)) ??
          cfg.games.find((g) => [g.title, g.titleAr, ...g.aliases].some((x) => norm(x).includes(n))) ??
          null
        );
      };
      q.addEventListener('input', () => {
        const g = find(q.value);
        if (g && g !== state.game) {
          state.game = g;
          render();
        }
      });
      q.addEventListener('change', () => {
        const g = find(q.value);
        if (g) q.value = label(g);
      });

      // ---------- النص ----------
      // وسم من اسم اللعبة: بدون رموز، والمسافات تصير _
      const tag = (s: string) =>
        '#' + s.replace(/[^\p{L}\p{N}\s]/gu, ' ').trim().replace(/\s+/g, '_');
      // نبذة قصيرة: أول جملة أو جملتين ضمن حد معقول
      const short = (s: string, max: number) => {
        if (s.length <= max) return s;
        const cut = s.slice(0, max);
        const end = Math.max(cut.lastIndexOf('.'), cut.lastIndexOf('،'), cut.lastIndexOf('!'));
        return end > max * 0.5 ? cut.slice(0, end + 1).replace(/،$/, '…') : cut.slice(0, cut.lastIndexOf(' ')) + '…';
      };

      function buildText(g: Game) {
        const ig = state.platform === 'ig';
        const name = `${g.titleAr} (${g.title})`;
        const L: string[] = [];
        if (state.kind === 'new') {
          if (g.status === 'complete') L.push(`🎮 تعريب لعبة ${name} متوفر الآن مجاناً! 🔥`);
          else if (g.status === 'beta') L.push(`🎮 النسخة التجريبية من تعريب ${name} متوفرة الآن مجاناً! 🔥`);
          else L.push(`🛠️ العمل جارٍ على تعريب ${name}${g.progress != null ? ` — الإنجاز ${g.progress}%` : ''}`);
          L.push('', short(g.summary, ig ? 300 : 260), '');
          L.push('✅ تعريب عربي بخط واضح', '✅ أداة تثبيت سهلة بضغطة زر', '✅ يعمل على Steam و Epic و GOG', '✅ مجاني بالكامل');
        } else {
          L.push(`🔄 تحديث جديد لتعريب ${name} — الإصدار v${g.version}`);
          if (g.gameVersion) L.push(`يدعم نسخة اللعبة ${g.gameVersion}`);
          L.push('');
          if (g.notes.length) {
            L.push('📝 الجديد في هذا التحديث:');
            for (const n of g.notes.slice(0, 8)) L.push(`▪️ ${n}`);
          } else L.push('📝 إصلاحات وتحسينات في التعريب.');
          L.push('', 'ثبّت النسخة الجديدة بنفس أداة التثبيت وستُحدَّث الملفات تلقائياً.');
        }
        L.push('');
        if (ig) {
          L.push('📥 رابط التحميل في البايو 🔗');
          L.push(`أو ابحث في Google عن: تعريب ${g.title} تعريبات`);
        } else {
          L.push('📥 التحميل من هنا:', g.url);
          if (cfg.discord) L.push('', '💬 للمشاكل والاقتراحات انضم لسيرفر الديسكورد:', cfg.discord);
        }
        L.push('');
        const base = ['#تعريبات', '#تعريب', tag(g.title), tag(`تعريب ${g.titleAr}`)];
        const extra = ig
          ? ['#ألعاب', '#العاب_كمبيوتر', '#ألعاب_مترجمة', '#قيمرز', '#جيمرز_العرب', '#PCGaming', '#gaming']
          : ['#ألعاب_مترجمة', '#العاب_كمبيوتر'];
        L.push([...new Set([...base, ...g.aliases.slice(0, ig ? 3 : 1).map(tag), ...extra])].join(' '));
        return L.join('\n');
      }

      // ---------- الصورة ----------
      const imgCache = new Map<string, Promise<HTMLImageElement>>();
      const loadImg = (src: string) => {
        if (!imgCache.has(src))
          imgCache.set(
            src,
            new Promise((ok, bad) => {
              const im = new Image();
              im.onload = () => ok(im);
              im.onerror = bad;
              im.src = src;
            }),
          );
        return imgCache.get(src)!;
      };
      const fontsReady = Promise.all([
        document.fonts.load('800 60px Tajawal', 'تعريب Ab'),
        document.fonts.load('700 40px Tajawal', 'تعريب Ab'),
        document.fonts.load('700 40px "Reem Kufi"', 'تعريب'),
      ]).catch(() => {});

      function cover(ctx: CanvasRenderingContext2D, im: HTMLImageElement, w: number, h: number) {
        const s = Math.max(w / im.width, h / im.height);
        const iw = im.width * s, ih = im.height * s;
        ctx.drawImage(im, (w - iw) / 2, (h - ih) / 2, iw, ih);
      }
      // يصغّر الخط حتى يدخل النص في العرض المتاح
      function fit(ctx: CanvasRenderingContext2D, t: string, weight: string, size: number, family: string, maxW: number) {
        let s = size;
        do ctx.font = `${weight} ${s}px ${family}`;
        while (ctx.measureText(t).width > maxW && (s -= 2) > 16);
        return s;
      }
      function pill(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
        ctx.beginPath();
        ctx.roundRect(x, y, w, h, r);
      }

      let drawId = 0;
      async function draw(g: Game) {
        const id = ++drawId;
        const ig = state.platform === 'ig';
        const W = ig ? 1080 : 1200, H = ig ? 1350 : 630;
        const [im, logo] = await Promise.all([loadImg(g.img), loadImg('/logo.svg').catch(() => null), fontsReady]);
        if (id !== drawId) return;
        cv.width = W;
        cv.height = H;
        $('size').textContent = ig ? '1080×1350 (منشور إنستغرام عمودي)' : '1200×630 (منشور فيسبوك)';
        const ctx = cv.getContext('2d')!;
        ctx.direction = 'rtl';
        cover(ctx, im, W, H);
        // إنستغرام عمودي: صورة اللعبة العريضة تُقص لو ملأت الإطار، فتُعرض كاملة بعرض الإطار
        // فوق نسخة مموّهة منها، والنص تحتها
        let shadeTop = H * 0.2;
        if (ig) {
          ctx.save();
          ctx.filter = 'blur(40px) brightness(.45)';
          cover(ctx, im, W, H);
          ctx.restore();
          const ih = Math.min(Math.round((W * im.height) / im.width), 720);
          const top = Math.max(160, Math.round((1000 - ih) / 2 + 70)); // في المنتصف بين الشارة والعنوان
          const sh = (ih * im.width) / W; // الصور الأطول من الإطار فقط تُقص من الأعلى والأسفل بالتساوي
          ctx.drawImage(im, 0, (im.height - sh) / 2, im.width, sh, 0, top, W, ih);
          shadeTop = top + ih * 0.7;
        }
        // تظليل من الأسفل حتى يُقرأ النص فوق أي صورة
        const gr = ctx.createLinearGradient(0, shadeTop, 0, H);
        gr.addColorStop(0, 'rgba(11,13,23,0)');
        gr.addColorStop(0.5, 'rgba(11,13,23,0.88)');
        gr.addColorStop(1, 'rgba(11,13,23,0.97)');
        ctx.fillStyle = gr;
        ctx.fillRect(0, 0, W, H);

        const pad = ig ? 64 : 56;
        const right = W - pad;
        ctx.textAlign = 'right';
        ctx.textBaseline = 'alphabetic';

        // شارة أعلى الصورة
        const badge =
          state.kind === 'update' ? `تحديث v${g.version}` : g.status === 'complete' ? 'تعريب جديد' : g.status === 'beta' ? 'نسخة تجريبية' : 'قيد العمل';
        ctx.font = `800 ${ig ? 38 : 30}px Tajawal`;
        const bw = ctx.measureText(badge).width + (ig ? 56 : 44), bh = ig ? 70 : 54;
        pill(ctx, right - bw, pad, bw, bh, bh / 2);
        ctx.fillStyle = state.kind === 'update' ? '#f59e0b' : '#19c3d6';
        ctx.fill();
        ctx.fillStyle = '#0b0d17';
        ctx.textBaseline = 'middle';
        ctx.fillText(badge, right - (ig ? 28 : 22), pad + bh / 2 + 2);
        ctx.textBaseline = 'alphabetic';

        // الاسم العربي ثم الإنجليزي ثم سطر التعريب
        let y = H - (ig ? 150 : 104);
        const maxW = W - pad * 2;
        ctx.fillStyle = '#ffffff';
        ctx.shadowColor = 'rgba(0,0,0,.6)';
        ctx.shadowBlur = 18;
        const enSize = fit(ctx, g.title, '700', ig ? 46 : 34, 'Tajawal', maxW);
        const arSize = fit(ctx, g.titleAr, '800', ig ? 96 : 64, 'Tajawal', maxW);
        ctx.font = `800 ${arSize}px Tajawal`;
        ctx.fillText(g.titleAr, right, y - enSize - (ig ? 34 : 22));
        ctx.font = `700 ${enSize}px Tajawal`;
        ctx.fillStyle = '#c9cde6';
        ctx.direction = 'ltr';
        ctx.textAlign = 'right';
        ctx.fillText(g.title, right, y);
        ctx.direction = 'rtl';
        ctx.shadowBlur = 0;

        // الشريط السفلي: الشعار والموقع
        y = H - (ig ? 64 : 44);
        ctx.fillStyle = '#19c3d6';
        ctx.fillRect(pad, y - (ig ? 56 : 42), maxW, 3);
        const ls = ig ? 52 : 40;
        if (logo) ctx.drawImage(logo, right - ls, y - ls + 6, ls, ls);
        ctx.font = `700 ${ig ? 40 : 30}px "Reem Kufi", Tajawal`;
        ctx.fillStyle = '#ffffff';
        ctx.fillText(cfg.siteName, right - ls - 14, y);
        ctx.font = `700 ${ig ? 34 : 26}px Tajawal`;
        ctx.fillStyle = '#19c3d6';
        ctx.textAlign = 'left';
        ctx.direction = 'ltr';
        ctx.fillText(cfg.site.replace('https://', ''), pad, y);
        ctx.direction = 'rtl';
      }

      function render() {
        const g = state.game;
        $('out').hidden = !g;
        $('empty').hidden = !!g;
        if (!g) return;
        text.value = buildText(g);
        updateCount();
        $<HTMLAnchorElement>('open').href = g.url;
        const ig = state.platform === 'ig';
        $('post').textContent = ig ? '📷 نشر على إنستغرام' : 'f نشر على فيسبوك';
        $('hint').textContent = ig
          ? 'زر النشر يحمّل الصورة وينسخ النص ويفتح إنستغرام: اضغط (+) ← اختر الصورة ← الصق النص بـ Ctrl+V ← مشاركة. ضع رابط الموقع في البايو لأن روابط المنشور لا تُضغط.'
          : 'زر النشر ينشر الصورة والنص مباشرة على صفحة فيسبوك (عدّل النص قبل الضغط إن أردت).';
        draw(g);
      }
      function updateCount() {
        const tags = (text.value.match(/#\S+/g) ?? []).length;
        $('count').textContent = `${text.value.length} حرف · ${tags} وسم${state.platform === 'ig' && tags > 30 ? ' (إنستغرام يقبل 30 كحد أقصى)' : ''}`;
      }
      text.addEventListener('input', updateCount);

      async function copyText() {
        try {
          await navigator.clipboard.writeText(text.value);
        } catch {
          text.select();
          document.execCommand('copy');
        }
      }
      const fileName = (g: Game) =>
        `${g.id}-${state.platform === 'ig' ? 'instagram' : 'facebook'}${state.kind === 'update' ? '-update' : ''}.png`;
      function downloadImage(g: Game) {
        const a = document.createElement('a');
        a.download = fileName(g);
        a.href = cv.toDataURL('image/png');
        a.click();
      }
      // مثل زر إكس: ضغطة واحدة تفتح النشر والنص جاهز في الحافظة
      $('post').addEventListener('click', async () => {
        const g = state.game;
        if (!g) return;
        // النسخ أولاً (الحافظة تحتاج أن تكون الصفحة في الواجهة)، ثم فتح النافذة ما زال ضمن نفس الضغطة
        await copyText();
        if (state.platform === 'fb') {
          // نشر مباشر على صفحة فيسبوك من الخادم: الصورة المصممة + النص كما هو في المربع
          if (!confirm('نشر المنشور الآن على صفحة فيسبوك (الصورة + النص)؟')) return;
          const b = $<HTMLButtonElement>('post');
          b.disabled = true;
          b.textContent = '… جارٍ النشر';
          try {
            const res = await fetch('/api/facebook', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({ message: text.value, image: cv.toDataURL('image/png') }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || 'حدث خطأ');
            b.textContent = '✔ نُشر على فيسبوك';
            if (data.url) window.open(data.url, '_blank');
          } catch (err) {
            const msg = (err as Error).message;
            b.textContent = 'f نشر على فيسبوك';
            if (msg.includes('FB_PAGE_ID')) {
              // النشر المباشر غير مفعّل بعد: الطريقة القديمة (النص في الحافظة + نافذة المشاركة)
              alert('النشر المباشر غير مفعّل بعد — النص منسوخ، الصقه بـ Ctrl+V في النافذة');
              window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(g.url)}`, 'fbshare', 'width=680,height=720');
            } else alert(msg);
          } finally {
            b.disabled = false;
          }
          return;
        }
        const mobile = matchMedia('(pointer: coarse)').matches && 'canShare' in navigator;
        if (!mobile) {
          // على الكمبيوتر: تحميل الصورة + فتح إنستغرام (النص في الحافظة)
          downloadImage(g);
          window.open('https://www.instagram.com/', '_blank');
          return;
        }
        // على الجوال: قائمة المشاركة بالصورة والنص (تظهر فيها إنستغرام)
        const blob: Blob | null = await new Promise((ok) => cv.toBlob(ok, 'image/png'));
        const file = blob && new File([blob], fileName(g), { type: 'image/png' });
        if (file && navigator.canShare({ files: [file] })) {
          try {
            await navigator.share({ files: [file], text: text.value });
            return;
          } catch {}
        }
        downloadImage(g);
        location.href = 'https://www.instagram.com/';
      });
      $('copy').addEventListener('click', async () => {
        await copyText();
        const b = $('copy');
        b.textContent = '✔ تم النسخ';
        setTimeout(() => (b.textContent = '📋 نسخ النص'), 1500);
      });
      $('dl').addEventListener('click', () => {
        if (state.game) downloadImage(state.game);
      });

      // ?game=slug يفتح لعبة مباشرة (رابط من لوحة التحكم)
      const params = new URLSearchParams(location.search);
      const pre = params.get('game');
      for (const id of ['kind', 'platform'] as const) {
        const v = params.get(id);
        const b = v && $(id).querySelector<HTMLButtonElement>(`button[data-v="${v}"]`);
        if (b) {
          $(id).querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
          state[id] = v;
        }
      }
      const g0 = (pre && cfg.games.find((g) => g.id === pre)) || null;
      if (g0) {
        state.game = g0;
        q.value = label(g0);
        render();
      }
    </script>

    <style>
      body { font-family: Tajawal, system-ui, sans-serif; }
      .sp datalist { display: none; }
      .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 12px; }
      .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; color: var(--text); text-decoration: none; }
      .sp { padding-block: 24px 60px; display: grid; gap: 18px; align-content: start; }
      .sp-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; display: grid; gap: 12px; align-content: start; }
      .sp-opts { grid-template-columns: 1fr auto auto; align-items: end; align-content: start; gap: 18px; }
      .sp-field { display: grid; gap: 6px; }
      .sp-field > span { color: var(--muted); font-size: 0.9rem; }
      .sp-field input, .sp textarea {
        width: 100%; background: var(--bg); color: var(--text); border: 1px solid var(--border);
        border-radius: var(--radius-sm); padding: 10px 12px; font: inherit; font-size: 1rem;
      }
      .sp textarea { resize: vertical; line-height: 1.7; unicode-bidi: plaintext; }
      .sp-seg { display: flex; border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
      .sp-seg button { background: var(--bg); color: var(--muted); border: 0; padding: 10px 16px; font: inherit; cursor: pointer; white-space: nowrap; }
      .sp-seg button.on { background: var(--accent); color: #0b0d17; font-weight: 800; }
      .sp-empty { color: var(--muted); text-align: center; padding: 40px 0; }
      .sp-out { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: start; }
      .sp-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
      .sp-head h2 { margin: 0; font-size: 1.15rem; }
      .sp-actions { display: flex; gap: 10px; flex-wrap: wrap; }
      .sp canvas { width: 100%; height: auto; border-radius: var(--radius-sm); background: var(--bg); }
      .small { font-size: 0.85rem; }
      .muted { color: var(--muted); }
      @media (max-width: 860px) {
        .sp-opts, .sp-out { grid-template-columns: 1fr; }
        .sp-seg button { flex: 1; }
      }
    </style>
  </body>
</html>
