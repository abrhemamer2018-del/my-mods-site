---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TranslationCard from '../components/TranslationCard.astro';
import { getArticles, getTranslations, lastTouched, formatDate } from '../lib/utils';
import Icon from '../components/Icon.astro';
import { SITE, SOCIAL } from '../config';

const translations = await getTranslations();
const featured = translations.filter((t) => t.data.featured);
// البانر: التعريبات المميزة أولاً، ثم نكمل بالأحدث حتى 5 شرائح
const HERO_MAX = 5;
const heroItems = [
  ...featured,
  ...translations.filter((t) => !t.data.featured).slice(0, Math.max(0, HERO_MAX - featured.length)),
].slice(0, Math.max(HERO_MAX, featured.length));
// جديد التعريبات: تظهر أول 12 ثم 12 أخرى كلما وصل الزائر لنهاية القائمة
// (12 يملأ الصفوف كاملة سواء كانت 4 أعمدة أو 3 أو 2)
const PAGE_SIZE = 12;

// آخر التحديثات: التعريبات التي لديها updatedDate
const updates = translations
  .filter((t) => t.data.updatedDate)
  .sort((a, b) => lastTouched(b).getTime() - lastTouched(a).getTime())
  .slice(0, 4);

// صورة تعريب اليوم: تُختار في المتصفح حسب تاريخ اليوم من كل لقطات الشاشة
const shots = await Promise.all(
  translations.flatMap((t) =>
    t.data.screenshots.map(async (s) => ({
      src: (await getImage({ src: s, width: 640 })).src,
      title: t.data.titleAr,
      href: `/translations/${t.id}/`,
    })),
  ),
);

// قسم المقالات يظهر فقط عند وجود 3 مقالات أو أكثر، حتى لا يبدو الموقع غير نشط
const ARTICLES_MIN = 3;
const allArticles = await getArticles();
const articles = allArticles.length >= ARTICLES_MIN ? allArticles.slice(0, 3) : [];

const lastAdded = translations[0]?.data.releaseDate;
const discord = SOCIAL.find((s) => s.icon === 'discord');
---

<BaseLayout>
  {/* العنوان الرئيسي للصفحة لمحركات البحث وقارئات الشاشة (مخفي بصرياً) */}
  <h1 class="sr-only">{SITE.name} — {SITE.tagline}</h1>
  {heroItems.length > 0 && <Hero items={heroItems} />}

  <div class="container home-grid section">
    <section class="latest">
      <div class="section-head">
        <h2>جديد التعريبات</h2>
        <a href="/translations/">المزيد ‹</a>
      </div>
      <div class="cards" id="latest-cards" data-page-size={PAGE_SIZE}>
        {translations.map((t, i) => <TranslationCard item={t} hidden={i >= PAGE_SIZE} />)}
      </div>
      {translations.length > PAGE_SIZE && <div id="latest-more" class="more-loader" aria-hidden="true" />}
      <a href="/translations/" class="btn all-link">عرض كل التعريبات مع البحث والتصنيفات ‹</a>
    </section>

    <aside class="side">
      {
        shots.length > 0 && (
          <section>
            <div class="section-head">
              <h2>صورة تعريب اليوم</h2>
            </div>
            <a class="panel shot" id="daily-shot" href={shots[0].href} data-shots={JSON.stringify(shots)}>
              <img src={shots[0].src} alt={`لقطة من تعريب ${shots[0].title}`} loading="lazy" />
              <span class="shot-title">{shots[0].title}</span>
            </a>
          </section>
        )
      }

      {
        updates.length > 0 && (
          <section>
            <div class="section-head">
              <h2>آخر التحديثات</h2>
            </div>
            <ul class="updates">
              {updates.map((t) => (
                <li>
                  <a href={`/translations/${t.id}/#changelog`} class="update">
                    <time
                      class="badge badge-green"
                      datetime={lastTouched(t).toISOString()}
                      data-ago="محدث "
                      title={formatDate(lastTouched(t))}
                    >
                      محدث {formatDate(lastTouched(t))}
                    </time>
                    <strong dir="ltr">{t.data.title}</strong>
                    <span class="muted">{t.data.titleAr}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="stats">
        <div class="panel stat">
          <strong>{translations.length}</strong>
          <span class="muted">تعريب</span>
        </div>
        <div class="panel stat">
          <strong dir="ltr" id="downloads-count" data-offset={SITE.downloadsOffset}>…</strong>
          <span class="muted">تحميل</span>
        </div>
        {
          lastAdded && (
            <div class="panel stat wide">
              <time class="last-added" datetime={lastAdded.toISOString()} data-ago="" title={formatDate(lastAdded)}>
                {formatDate(lastAdded)}
              </time>
              <span class="muted">آخر تعريب أُضيف</span>
            </div>
          )
        }
      </section>

      {
        discord && (
          <section class="panel cta">
            <Icon name="discord" size={34} />
            <h2>عندك لعبة تتمنى تعريبها؟</h2>
            <p class="muted">اطلبها في ديسكورد، وتابع أخبار التعريبات القادمة أولاً بأول.</p>
            <a href={discord.url} class="btn btn-primary" target="_blank" rel="noopener">
              انضم إلى ديسكورد
            </a>
          </section>
        )
      }
    </aside>
  </div>

  {/* كيف أثبّت التعريب؟ ثلاث خطوات تطمئن الزائر الجديد أن التثبيت سهل */}
  <section class="container section how" id="how">
    <div class="how-head">
      <h2>كيف أثبّت التعريب؟</h2>
      <p class="muted">ثلاث خطوات فقط، وكل تعريباتنا تعمل بنفس الطريقة.</p>
    </div>
    <ol class="steps">
      <li class="step">
        <span class="num">1</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg>
        </span>
        <h3>حمّل التعريب</h3>
        <p class="muted">اضغط "تحميل مباشر" في صفحة اللعبة، وفك ضغط الملف.</p>
      </li>
      <li class="step">
        <span class="num">2</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z" /></svg>
        </span>
        <h3>شغّل أداة التثبيت</h3>
        <p class="muted">اضغط "تثبيت"، والأداة تجد مجلد اللعبة تلقائياً.</p>
      </li>
      <li class="step">
        <span class="num">3</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5" /><path d="M7 11v3M5.5 12.5h3M15.5 12h.01M18 13.5h.01" /></svg>
        </span>
        <h3>العب بالعربية</h3>
        <p class="muted">شغّل اللعبة، وستجدها بالعربية مباشرة.</p>
      </li>
    </ol>
  </section>

  {
    articles.length > 0 && (
      <section class="container section">
        <div class="section-head">
          <h2>أحدث المقالات والدروس</h2>
          <a href="/articles/">المزيد ‹</a>
        </div>
        <div class="articles">
          {articles.map((a) => (
            <a href={`/articles/${a.id}/`} class="panel article">
              <span class="badge">{a.data.kind === 'lesson' ? 'درس' : 'مقال'}</span>
              <h3>{a.data.title}</h3>
              <p class="muted">{a.data.description}</p>
              <time class="muted" datetime={a.data.date.toISOString()}>
                {formatDate(a.data.date)}
              </time>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 40px;
    align-items: start;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  /* الشاشات الكبيرة: 4 بطاقات في الصف */
  @media (min-width: 1500px) {
    .cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .how-head {
    text-align: center;
    margin-bottom: 28px;
  }
  .how-head h2 {
    margin: 0 0 6px;
  }
  .how-head p {
    margin: 0;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    counter-reset: none;
  }
  .step {
    position: relative;
    text-align: center;
    padding: 30px 22px 26px;
    background:
      radial-gradient(circle at 50% 0%, rgb(25 195 214 / 0.12), transparent 65%),
      var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  /* سهم يصل بين الخطوات (الصفحة من اليمين لليسار) */
  .step:not(:last-child)::after {
    content: '‹';
    position: absolute;
    top: 50%;
    left: -17px;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 1.4rem;
    line-height: 1;
    z-index: 1;
    /* حتى لا يقلب المتصفح اتجاه السهم في الصفحة العربية */
    direction: ltr;
    unicode-bidi: isolate;
  }
  .num {
    position: absolute;
    top: 14px;
    inset-inline-start: 16px;
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ico {
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    color: #0b0d17;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 10px 30px rgb(25 195 214 / 0.25);
  }
  .step h3 {
    font-size: 1.2rem;
    margin: 0 0 6px;
  }
  .step p {
    margin: 0;
  }
  @media (max-width: 800px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .step:not(:last-child)::after {
      content: '⌄';
      top: auto;
      bottom: -21px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 1.1rem;
    }
  }
  .more-loader {
    height: 1px;
    margin-top: 20px;
  }
  .all-link {
    display: flex;
    justify-content: center;
    margin-top: 20px;
  }
  .last-added {
    display: block;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--accent);
  }
  .cta {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 10px;
    border-color: rgb(88 101 242 / 0.45);
    background:
      radial-gradient(circle at 50% 0%, rgb(88 101 242 / 0.28), transparent 70%),
      var(--card);
  }
  .cta :global(svg) {
    color: #8b95ff;
  }
  .cta h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .cta p {
    margin: 0 0 6px;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .shot {
    display: block;
    padding: 12px;
    position: relative;
    transition: border-color 0.2s;
  }
  .shot:hover {
    border-color: var(--accent);
  }
  .shot img {
    border-radius: 10px;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .shot-title {
    display: block;
    margin-top: 10px;
    text-align: center;
    color: var(--muted);
  }
  .updates {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 22px;
  }
  .update {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: visible;
    transition: border-color 0.2s;
  }
  .update:hover {
    border-color: var(--accent);
  }
  .update .badge {
    position: absolute;
    top: -11px;
    inset-inline-end: 14px;
  }
  .update strong {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .update span {
    white-space: nowrap;
    flex-shrink: 0;
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .stat {
    text-align: center;
    padding: 18px 10px;
  }
  .stat.wide {
    grid-column: span 2;
  }
  .stat strong {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--accent);
  }
  .articles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .article {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    transition: border-color 0.2s, transform 0.2s;
  }
  .article:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .article h3 {
    font-size: 1.2rem;
    margin: 4px 0 0;
  }
  .article p {
    margin: 0;
  }
  .article time {
    margin-top: auto;
    font-size: 0.85rem;
  }

  @media (max-width: 1100px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
    .side {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }
  @media (max-width: 800px) {
    .cards,
    .articles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    /* الجوال: بطاقتان في كل صف للتعريبات */
    .cards {
      gap: 12px;
    }
    .articles {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // عدد التحميلات الحقيقي من GitHub (عبر /api/downloads)
  const dlEl = document.getElementById('downloads-count');
  if (dlEl) {
    const offset = Number(dlEl.dataset.offset) || 0;
    const fmt = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
    fetch('/api/downloads')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then(({ total }) => (dlEl.textContent = fmt.format(total + offset)))
      .catch(() => (dlEl.textContent = offset ? fmt.format(offset) : '—'));
  }

  // التمرير اللانهائي: إظهار دفعة جديدة من التعريبات عند الاقتراب من نهاية القائمة
  const sentinel = document.getElementById('latest-more');
  const grid = document.getElementById('latest-cards');
  if (sentinel && grid) {
    const size = Number(grid.dataset.pageSize) || 6;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        const rest = grid.querySelectorAll<HTMLElement>(':scope > [hidden]');
        [...rest].slice(0, size).forEach((c) => (c.hidden = false));
        if (rest.length <= size) {
          observer.disconnect();
          sentinel.remove();
        } else {
          // إعادة المراقبة حتى تُفحص من جديد إن بقيت ظاهرة بعد إضافة الدفعة
          observer.unobserve(sentinel);
          requestAnimationFrame(() => observer.observe(sentinel));
        }
      },
      { rootMargin: '400px 0px' },
    );
    observer.observe(sentinel);
  }

  // اختيار لقطة مختلفة كل يوم
  const el = document.getElementById('daily-shot') as HTMLAnchorElement | null;
  if (el?.dataset.shots) {
    const shots: { src: string; title: string; href: string }[] = JSON.parse(el.dataset.shots);
    const day = Math.floor(Date.now() / 86400000);
    const pick = shots[day % shots.length];
    const img = el.querySelector('img')!;
    img.src = pick.src;
    img.alt = `لقطة من تعريب ${pick.title}`;
    el.href = pick.href;
    el.querySelector('.shot-title')!.textContent = pick.title;
  }
</script>
