---
import { Image } from 'astro:assets';
import { downloadCounts, topDownloaded, downloadsOf } from '../lib/downloads';
import soonData from '../data/soon.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TranslationCard from '../components/TranslationCard.astro';
import { getArticles, getTranslations, getUpcoming, formatDate } from '../lib/utils';
import Icon from '../components/Icon.astro';
import { LIVE, SITE, SOCIAL } from '../config';
import pinnedData from '../data/pinned.json';
import heroData from '../data/hero.json';

const translations = await getTranslations();
// قسم "جديد التعريبات": الألعاب الأحدث صدوراً أولاً (تاريخ صدور اللعبة)، ومن لا تاريخ لها حسب تاريخ التعريب
const pinnedIds = new Set(pinnedData.slugs);
const byGame = [...translations].filter((t) => !pinnedIds.has(t.id)).sort(
  (a, b) =>
    (b.data.gameRelease ?? b.data.releaseDate).getTime() - (a.data.gameRelease ?? a.data.releaseDate).getTime(),
);
// التعريبات المثبتة: تُختار وتُرتَّب من لوحة التحكم (نافذة "التعريبات المثبتة")، مستقلة عن البانر
const pinned = pinnedData.slugs
  .map((slug) => translations.find((t) => t.id === slug))
  .filter((t) => t !== undefined);
// البانر: الألعاب المختارة من لوحة التحكم (نافذة "البانر الرئيسي") بالترتيب.
// إن كانت القائمة فارغة: التعريبات المميزة أولاً، ثم نكمل بالأحدث حتى 5 شرائح
// "ta3reebat-live" في القائمة = شريحة برنامج تعريبات لايف بدل لعبة
const chosenHero = heroData.slugs
  .filter((slug) => !pinnedIds.has(slug))
  .map((slug) => (slug === LIVE.heroSlug ? 'live' : translations.find((t) => t.id === slug)))
  .filter((t) => t !== undefined);
const HERO_MAX = 10;
// إن كانت قائمة البانر فارغة في لوحة التحكم: آخر 10 تعريبات أُضيفت للموقع (بوقت الإضافة الدقيق)
const heroItems = chosenHero.length
  ? chosenHero
  : translations.filter((t) => !pinnedIds.has(t.id)).slice(0, HERO_MAX);
// نافذة الأكثر تحميلاً: أول 10 بعدد تحميلات ملفات GitHub وقت البناء
const top = await Promise.all(
  (await topDownloaded(translations, 10)).map(async (t) => ({ t, n: await downloadsOf(t) })),
);
const topMax = top[0]?.n ?? 1;
// احتياط إن تعذّر ‎/api/downloads (ومحلياً على الجهاز): مجموع التحميلات من GitHub وقت البناء
const dlTotal = [...(await downloadCounts()).values()].reduce((a, b) => a + b, 0);
// نافذة آخر التحديثات: كل نسخة في سجل التغييرات، الأحدث أولاً ("جديد" = أول نسخة، وغيرها "تحديث")
const updates = translations
  .flatMap((t) => {
    const log = [...t.data.changelog].sort((a, b) => b.date.getTime() - a.date.getTime());
    return log.map((c, i) => {
      const isNew = i === log.length - 1;
      // نفس اليوم: الأحدث بالوقت الدقيق (at، أو وقت الإضافة للإصدار الأول)
      const when = (c.at ?? (isNew ? t.data.addedAt : undefined) ?? c.date).getTime();
      return { t, c, prev: log[i + 1]?.version, isNew, when };
    });
  })
  .sort((a, b) => b.c.date.getTime() - a.c.date.getTime() || b.when - a.when || Number(a.isNew) - Number(b.isNew))
  .slice(0, 14);
// نافذة قريباً: ألعاب ستصدر (src/data/soon.json) تبقى 14 يوماً بعد صدورها، وتعريبات قيد العمل
const soon = soonData.games
  .filter((g) => Date.now() - new Date(g.date).getTime() < 14 * 86400000)
  .sort((a, b) => a.date.localeCompare(b.date));
const inProgress = await getUpcoming();
const soonCount = soon.length + inProgress.length;
// نقطة تنبيه حمراء على خانة "قريباً" إن كانت لعبة ستصدر خلال 7 أيام
const soonHot = soon.some((g) => {
  const d = new Date(g.date).getTime() - Date.now();
  return d > -86400000 && d < 7 * 86400000;
});
const longDate = new Intl.DateTimeFormat('ar', { day: 'numeric', month: 'long', year: 'numeric' });
const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
// أزرار تصفية "أحدث الألعاب المعرّبة" بالنوع، من وسوم Steam المحفوظة لكل تعريب
const CATS = [
  { id: 'action', label: 'أكشن', tags: ['Action', 'Hack and Slash', 'Shooter', 'FPS', "Beat 'em up"] },
  { id: 'adventure', label: 'مغامرة', tags: ['Adventure', 'Action-Adventure', 'Exploration'] },
  { id: 'rpg', label: 'تقمّص أدوار', tags: ['RPG', 'Action RPG', 'JRPG', 'Souls-like', 'CRPG'] },
  { id: 'horror', label: 'رعب', tags: ['Horror', 'Psychological Horror', 'Survival Horror'] },
  { id: 'open', label: 'عالم مفتوح', tags: ['Open World', 'Sandbox'] },
  { id: 'story', label: 'قصصية', tags: ['Story Rich', 'Choices Matter', 'Visual Novel'] },
  { id: 'survival', label: 'بقاء', tags: ['Survival', 'Crafting', 'Base Building'] },
  { id: 'coop', label: 'لعب جماعي', tags: ['Co-op', 'Online Co-Op', 'Multiplayer'] },
  { id: 'sim', label: 'محاكاة وإستراتيجية', tags: ['Simulation', 'Strategy', 'Management', 'City Builder', 'Automation'] },
];
const catsOf = (t: (typeof translations)[number]) =>
  CATS.filter((c) => c.tags.some((tag) => t.data.tags.includes(tag))).map((c) => c.id);
// يظهر الزر فقط إن كان في النوع 5 ألعاب على الأقل
const shownCats = CATS.map((c) => ({ ...c, n: byGame.filter((t) => catsOf(t).includes(c.id)).length })).filter((c) => c.n >= 5);
const dlOf = new Map(await Promise.all([...byGame, ...pinned].map(async (t) => [t.id, await downloadsOf(t)] as const)));
const filesOf = (t: (typeof translations)[number]) => t.data.downloads.map((f) => decodeURIComponent(f.url.split('/').pop() ?? '')).join('|');
// جديد التعريبات بعرض الصفحة: تظهر أول 30 (6 صفوف من 5)، و"عرض المزيد" يُظهر 30 أخرى عند كل ضغطة
const PAGE_SIZE = 30;

// قسم المقالات يظهر فقط عند وجود 3 مقالات أو أكثر، حتى لا يبدو الموقع غير نشط
const ARTICLES_MIN = 3;
const allArticles = await getArticles();
const articles = allArticles.length >= ARTICLES_MIN ? allArticles.slice(0, 3) : [];

const lastAdded = translations[0]?.data.releaseDate;
const discord = SOCIAL.find((s) => s.icon === 'discord');
// البيانات المنظمة للموقع: الاسم والشعار وحسابات التواصل (Organization)، والموقع نفسه (WebSite)
const siteUrl = new URL('/', Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: 'Ta3reebat',
    url: siteUrl,
    inLanguage: 'ar',
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: siteUrl,
    logo: new URL('/icon-512.png', Astro.site).href,
    sameAs: SOCIAL.filter((x) => x.icon !== 'heart').map((x) => x.url),
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  {/* العنوان الرئيسي للصفحة لمحركات البحث وقارئات الشاشة (مخفي بصرياً) */}
  <h1 class="sr-only">موقع {SITE.name} — {SITE.tagline}</h1>
  {heroItems.length > 0 && <Hero items={heroItems} recent={!chosenHero.length} />}

  {/* شريط الإحصائيات مدمج على الحافة السفلية للبانر */}
  <div class="container stats-wrap">
    <ul class="stats-strip">
      <li>
        <a href="/translations/" class="s-btn">
          <span class="s-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5" /><path d="M7 11v3M5.5 12.5h3M15.5 12h.01M18 13.5h.01" /></svg></span>
          <span class="s-txt">
            <span class="s-main"><strong>{translations.length}</strong><span>تعريب</span></span>
            <small>كل التعريبات <i aria-hidden="true">‹</i></small>
          </span>
        </a>
      </li>
      {/* الخانات الثلاث التالية تفتح نافذة الاستكشاف على القسم المناسب */}
      <li>
        <button type="button" class="s-btn" data-open="popular" aria-haspopup="dialog">
          <span class="s-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg></span>
          <span class="s-txt">
            <span class="s-main"><strong dir="ltr" id="downloads-count" data-offset={SITE.downloadsOffset} data-fallback={dlTotal}>…</strong><span>تحميل</span></span>
            <small>الأكثر تحميلاً <i aria-hidden="true">‹</i></small>
          </span>
        </button>
      </li>
      {
        lastAdded && (
          <li>
            <button type="button" class="s-btn" data-open="updates" aria-haspopup="dialog">
              <span class="s-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>
              <span class="s-txt">
                <span class="s-main">
                  <span>آخر إضافة<span class="colon">:</span></span>
                  <time datetime={lastAdded.toISOString()} data-ago="" title={formatDate(lastAdded)}>{formatDate(lastAdded)}</time>
                </span>
                <small>آخر التحديثات <i aria-hidden="true">‹</i></small>
              </span>
            </button>
          </li>
        )
      }
      <li>
        <button type="button" class="s-btn" data-open="soon" aria-haspopup="dialog">
          <span class="s-ico" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h12M6 22h12M7 2v4l5 6 5-6V2M7 22v-4l5-6 5 6v4" /></svg>
            {soonHot && <span class="live-dot ico-hot" />}
          </span>
          <span class="s-txt">
            <span class="s-main"><strong>{soonCount}</strong><span>قريباً</span></span>
            <small>ألعاب قادمة <i aria-hidden="true">‹</i></small>
          </span>
        </button>
      </li>
      {/* برنامج تعريبات لايف: رابط بنفس شكل الإحصائيات مع شارة LIVE حمراء وامضة */}
      <li class="s-live">
        <a href="/live/" title={LIVE.tagline}>
          <span class="s-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></svg><span class="live-dot ico-dot"></span></span>
          <span class="live-txt">
            <b>{LIVE.name} <span class="live-pill" aria-hidden="true"><span class="live-dot"></span>LIVE</span></b>
            <small>عرّب بضغطة زر واحدة</small>
          </span>
        </a>
      </li>
    </ul>
    {/* الجوال فقط: زر رفيع لتعريبات لايف تحت الإحصائيات */}
    <a href="/live/" class="live-slim">
      <span class="live-pill" aria-hidden="true"><span class="live-dot"></span>LIVE</span>
      <span>{LIVE.name}: عرّب أي لعبة بضغطة زر</span>
      <span class="live-slim-go" aria-hidden="true">‹</span>
    </a>
  </div>

  {/* نافذة الاستكشاف: ثلاثة أقسام بتبويبات، تُفتح من شريط الإحصائيات أو برابط مثل ‎/#popular */}
  <dialog id="hub" class="hub" aria-labelledby="hub-title">
    <div class="hub-in">
      <header class="hub-head">
        <h2 id="hub-title" class="sr-only">استكشف التعريبات</h2>
        <div class="hub-tabs" role="tablist">
          <button type="button" role="tab" class="hub-tab" data-tab="popular">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg>
            <span>الأكثر تحميلاً</span>
          </button>
          <button type="button" role="tab" class="hub-tab" data-tab="updates">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5" /></svg>
            <span>آخر التحديثات</span>
          </button>
          <button type="button" role="tab" class="hub-tab" data-tab="soon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2h12M6 22h12M7 2v4l5 6 5-6V2M7 22v-4l5-6 5 6v4" /></svg>
            <span>قريباً</span>
            {soonCount > 0 && <span class="hub-count">{soonCount}</span>}
          </button>
          <span class="hub-ink" aria-hidden="true" />
        </div>
        <button type="button" class="hub-x" data-close aria-label="إغلاق">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </header>

      <div class="hub-body" tabindex="-1" autofocus>
        {/* الأكثر تحميلاً: منصة للثلاثة الأوائل ثم قائمة مرتبة */}
        <section class="hub-panel" data-panel="popular" role="tabpanel">
          <p class="hub-sub">ترتيب التعريبات حسب عدد التحميلات الفعلي، ويتحدّث مع كل نشر في الموقع.</p>
          {top.length === 0 ? (
            <p class="hub-empty">تعذّر جلب أرقام التحميل الآن، حاول لاحقاً.</p>
          ) : (
            <Fragment>
              <div class="podium">
                {top.slice(0, 3).map(({ t, n }, i) => (
                  <a href={`/translations/${t.id}/`} class:list={['pod', `pod-${i + 1}`]}>
                    <span class="pod-img">
                      <Image src={t.data.cover} alt={`تعريب لعبة ${t.data.titleAr}`} width={520} />
                      <span class="medal" aria-label={`المركز ${i + 1}`}>{i + 1}</span>
                    </span>
                    <span class="pod-info">
                      <strong dir="ltr">{t.data.title}</strong>
                      <span>{t.data.titleAr}</span>
                      <em><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg><b dir="ltr">{compact.format(n)}</b> تحميل</em>
                    </span>
                  </a>
                ))}
              </div>
              <ol class="rank">
                {top.slice(3).map(({ t, n }, i) => (
                  <li>
                    <a href={`/translations/${t.id}/`} class="rank-row">
                      <span class="rank-n">{i + 4}</span>
                      <Image class="rank-img" src={t.data.cover} alt="" width={200} />
                      <span class="rank-names">
                        <strong dir="ltr">{t.data.title}</strong>
                        <span>{t.data.titleAr}</span>
                      </span>
                      <span class="rank-bar" aria-hidden="true"><span style={`width:${Math.max(6, (n / topMax) * 100)}%`} /></span>
                      <span class="rank-c"><b dir="ltr">{compact.format(n)}</b><small>تحميل</small></span>
                    </a>
                  </li>
                ))}
              </ol>
            </Fragment>
          )}
        </section>

        {/* آخر التحديثات: خط زمني مع تصفية (الكل / تحديثات / جديد) */}
        <section class="hub-panel" data-panel="updates" role="tabpanel">
          <div class="chips" role="group" aria-label="تصفية">
            <button type="button" class="chip on" data-filter="all">الكل</button>
            <button type="button" class="chip" data-filter="upd">تحديثات</button>
            <button type="button" class="chip" data-filter="new">إضافات جديدة</button>
          </div>
          <ul class="tl">
            {updates.map(({ t, c, prev, isNew }) => (
              <li data-kind={isNew ? 'new' : 'upd'}>
                <a href={`/translations/${t.id}/`} class="tl-row">
                  <span class="tl-dot" aria-hidden="true" />
                  <Image class="tl-img" src={t.data.cover} alt="" width={240} />
                  <span class="tl-main">
                    <span class="tl-top">
                      <strong dir="ltr">{t.data.title}</strong>
                      {isNew ? (
                        <span class="tag tag-new">جديد</span>
                      ) : (
                        <span class="tag tag-upd" dir="ltr">{prev && <s>{prev}</s>}<span aria-hidden="true">→</span>{c.version}</span>
                      )}
                    </span>
                    <span class="tl-note">{c.notes[0] ?? `تعريب ${t.data.titleAr} متاح الآن`}</span>
                  </span>
                  <time class="tl-time" datetime={c.date.toISOString()} data-ago="" title={formatDate(c.date)}>{formatDate(c.date)}</time>
                </a>
              </li>
            ))}
          </ul>
          <a href="/translations/" class="hub-more">كل التعريبات ‹</a>
        </section>

        {/* قريباً: ألعاب ستصدر بعدّاد تنازلي، وتعريبات قيد العمل */}
        <section class="hub-panel" data-panel="soon" role="tabpanel">
          <p class="hub-sub">ألعاب ننوي تعريبها فور صدورها. تابع الديسكورد ليصلك تنبيه لحظة نزول التعريب.</p>
          {soon.length === 0 && inProgress.length === 0 && <p class="hub-empty">لا توجد ألعاب قادمة حالياً.</p>}
          <div class="soon-list">
            {soon.map((g) => (
              <article class="soon-card">
                <img class="soon-bg" src={g.image} alt="" aria-hidden="true" loading="lazy" />
                <img class="soon-img" src={g.image} alt={g.title} loading="lazy" />
                <div class="soon-info">
                  <span class="soon-state" data-state>بانتظار الصدور</span>
                  <h3 dir="ltr">{g.title}</h3>
                  {g.titleAr && <p class="soon-ar">{g.titleAr}</p>}
                  <p class="soon-date">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                    تصدر {longDate.format(new Date(g.date))}
                  </p>
                  <div class="cd" data-countdown={g.date}>
                    <span><b data-u="d">0</b><small>يوم</small></span>
                    <span><b data-u="h">0</b><small>ساعة</small></span>
                    <span><b data-u="m">0</b><small>دقيقة</small></span>
                    <span><b data-u="s">0</b><small>ثانية</small></span>
                  </div>
                  <div class="soon-cta">
                    {discord && (
                      <a href={discord.url} class="btn btn-primary" target="_blank" rel="noopener">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0" /></svg>
                        نبّهني في الديسكورد
                      </a>
                    )}
                    <a href={g.url} class="btn soon-ghost" target="_blank" rel="noopener">صفحة Steam</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
          {inProgress.length > 0 && (
            <Fragment>
              <h3 class="hub-h3">قيد التعريب الآن</h3>
              <ul class="prog">
                {inProgress.map((t) => (
                  <li>
                    <a href={`/translations/${t.id}/`}>
                      <Image src={t.data.cover} alt="" width={200} />
                      <span><strong dir="ltr">{t.data.title}</strong><span class="prog-bar"><span style={`width:${t.data.progress ?? 0}%`} /></span></span>
                      <b>{t.data.progress ?? 0}%</b>
                    </a>
                  </li>
                ))}
              </ul>
            </Fragment>
          )}
        </section>
      </div>
    </div>
  </dialog>

  {/* تعريبات مثبتة: تُختار من لوحة التحكم ← "التعريبات المثبتة".
      يختفي القسم تلقائياً إن لم يوجد أي تعريب مثبت */}
  {
    pinned.length > 0 && (
      <section class="container pinned-sec">
        <div class="section-head">
          <h2>أبرز التعريبات</h2>
        </div>
        <div class="pin-grid">
          {pinned.map((t) => (
            <a href={`/translations/${t.id}/`} class="pin-card" data-files={filesOf(t)}>
              {/* هالة ضوء بألوان غلاف اللعبة نفسها تنعكس تحت البطاقة */}
              <Image class="pin-glow" src={t.data.cover} alt="" width={320} aria-hidden="true" />
              {/* إطار متدرج بألوان الشعار، والغلاف كاملاً بنسبته 16:9 بلا قص */}
              <span class="pin-frame">
                <span class="pin-in">
                  <Image class="pin-img" src={t.data.cover} alt={`تعريب لعبة ${t.data.titleAr} (${t.data.title})`} width={760} />
                  {/* الجوال: شارة "مثبّت" والاسم على تدرج داكن أسفل الغلاف */}
                  <span class="pin-m" aria-hidden="true">
                    <span class="pin-tag">مثبّت</span>
                    <span class="pin-m-names">
                      <strong dir="ltr">{t.data.title}</strong>
                      <span>{t.data.titleAr}</span>
                    </span>
                  </span>
                  {/* شارة عدد التحميلات أعلى الغلاف؛ تتحدّث في المتصفح من ‎/api/downloads */}
                  <span class="pin-dl" hidden={!(dlOf.get(t.id)! > 0)}>
                    <span class="pin-dl-ic">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg>
                    </span>
                    <b dir="ltr" class="pin-dl-n">{compact.format(dlOf.get(t.id) ?? 0)}</b>
                    <small>تحميل</small>
                  </span>
                  {/* لوحة زجاجية للاسم */}
                  <span class="pin-glass">
                    <span class="pin-flag" aria-label="مثبت">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 3a1 1 0 0 1 .7 1.7L15 6.4v4.2l2.6 2.6a1 1 0 0 1-.7 1.8H13v5.5a1 1 0 0 1-2 0V15H7.1a1 1 0 0 1-.7-1.8L9 10.6V6.4L7.3 4.7A1 1 0 0 1 8 3z" /></svg>
                    </span>
                    <span class="pin-names">
                      <strong dir="ltr">{t.data.title}</strong>
                      <span>{t.data.titleAr}</span>
                    </span>
                  </span>
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }


  {/* فاصل خفيف بتدرج ألوان الشعار */}
  {pinned.length > 0 && <div class="container"><hr class="soft-divider pin-divider" /></div>}

  {/* جديد التعريبات بعرض الصفحة كاملة */}
  <section class="container section latest">
    <div class="section-head">
      <h2>أحدث الألعاب المعرّبة</h2>
      <a href="/translations/" class="more-pill">كل التعريبات ‹</a>
    </div>
    {
      shownCats.length > 0 && (
        <div class="cat-chips" role="group" aria-label="تصفية حسب النوع">
          <button type="button" class="cat on" data-cat="">الكل <span>{byGame.length}</span></button>
          {shownCats.map((c) => (
            <button type="button" class="cat" data-cat={c.id}>
              {c.label} <span>{c.n}</span>
            </button>
          ))}
        </div>
      )
    }
    <div class="cards" id="latest-cards" data-page-size={PAGE_SIZE}>
      {byGame.map((t, i) => (
        <TranslationCard item={t} hidden={i >= PAGE_SIZE} downloads={dlOf.get(t.id)} cats={catsOf(t).join('|')} />
      ))}
    </div>
    <script is:inline>
      // إكمال الصف الأخير فوراً قبل أن يُرسم ما تحته، حتى لا تنزل الصفحة بعد ظهورها (CLS)
      (() => {
        const g = document.getElementById('latest-cards');
        const cols = getComputedStyle(g).gridTemplateColumns.split(' ').length;
        const hidden = g.querySelectorAll(':scope > [hidden]');
        const missing = (cols - ((g.children.length - hidden.length) % cols)) % cols;
        for (let i = 0; i < missing && i < hidden.length; i++) hidden[i].hidden = false;
      })();
    </script>
    {
      byGame.length > PAGE_SIZE && (
        <div class="more-wrap" id="more-wrap">
          {/* خط فاصل يمر خلف الزر ويربطه بنهاية القائمة */}
          <button type="button" id="latest-more" class="more-bar">
            عرض المزيد
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <span class="more-count muted" id="more-count" />
        </div>
      )
    }
  </section>

  {/* منطقة "ما وجدت لعبتك؟": بطاقتان هادئتان متجاورتان — تعريبات لايف وديسكورد */}
  <div class="container"><hr class="soft-divider duo-divider" /></div>
  <section class="container duo">
    <a href="/live/" class="duo-card duo-live">
      <span class="duo-thumb">
        <img src="/live/after.webp" alt="" width="1280" height="673" loading="lazy" aria-hidden="true" />
      </span>
      <span class="duo-body">
        <span class="duo-kicker"><span class="duo-dot"></span>جديد · برنامج مجاني</span>
        <strong class="duo-title">لعبتك غير معرّبة؟ جرّب تعريبات لايف</strong>
        <span class="duo-text">{LIVE.tagline}</span>
      </span>
      <span class="btn btn-primary duo-btn">اكتشف ‹</span>
    </a>
    {
      discord && (
        <a href={discord.url} class="duo-card duo-discord" target="_blank" rel="noopener">
          <span class="duo-ico">
            <Icon name="discord" size={24} />
          </span>
          <span class="duo-body">
            <strong class="duo-title">عندك لعبة تتمنى تعريبها؟</strong>
            <span class="duo-text">اطلبها في ديسكورد وتابع أخبار التعريبات القادمة.</span>
          </span>
          <span class="btn duo-btn duo-btn-discord">انضم ‹</span>
        </a>
      )
    }
  </section>
  <div class="container"><hr class="soft-divider soft-divider-end" /></div>

  {/* كيف أثبّت التعريب؟ ثلاث خطوات تطمئن الزائر الجديد أن التثبيت سهل */}
  <section class="container section how" id="how">
    <div class="how-head">
      <h2>كيف أثبّت التعريب؟</h2>
      <p class="muted">ثلاث خطوات فقط، وكل تعريباتنا تعمل بنفس الطريقة.</p>
    </div>
    <ol class="steps">
      <li class="step">
        <span class="num">1</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg>
        </span>
        <h3>حمّل التعريب</h3>
        <p class="muted">اضغط "تحميل مباشر" في صفحة اللعبة، وفك ضغط الملف.</p>
      </li>
      <li class="step">
        <span class="num">2</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z" /></svg>
        </span>
        <h3>شغّل أداة التثبيت</h3>
        <p class="muted">اضغط "تثبيت"، والأداة تجد مجلد اللعبة تلقائياً.</p>
      </li>
      <li class="step">
        <span class="num">3</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5" /><path d="M7 11v3M5.5 12.5h3M15.5 12h.01M18 13.5h.01" /></svg>
        </span>
        <h3>العب بالعربية</h3>
        <p class="muted">شغّل اللعبة، وستجدها بالعربية مباشرة.</p>
      </li>
    </ol>
  </section>

  {
    articles.length > 0 && (
      <section class="container section">
        <div class="section-head">
          <h2>أحدث المقالات والدروس</h2>
          <a href="/articles/">المزيد ‹</a>
        </div>
        <div class="articles">
          {articles.map((a) => (
            <a href={`/articles/${a.id}/`} class="panel article">
              <span class="badge">{a.data.kind === 'lesson' ? 'درس' : 'مقال'}</span>
              <h3>{a.data.title}</h3>
              <p class="muted">{a.data.description}</p>
              <time class="muted" datetime={a.data.date.toISOString()}>
                {formatDate(a.data.date)}
              </time>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
