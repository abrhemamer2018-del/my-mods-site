<script>
  // عدد التحميلات الحقيقي من GitHub (عبر /api/downloads)
  const dlEl = document.getElementById('downloads-count');
  if (dlEl) {
    const offset = Number(dlEl.dataset.offset) || 0;
    const fmt = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
    fetch('/api/downloads')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then(({ total, files }) => {
        dlEl.textContent = fmt.format(total + offset);
        // أرقام البطاقات الحالية (لا ننتظر البناء التالي للموقع)
        if (!files) return;
        document.querySelectorAll<HTMLElement>('.card[data-files]').forEach((card) => {
          const n = card.dataset.files!.split('|').reduce((sum, f) => sum + (files[f] || 0), 0);
          if (!n) return;
          card.querySelector('.dl-n')!.textContent = fmt.format(n);
          card.querySelector<HTMLElement>('.dls')!.hidden = false;
          card.querySelector<HTMLElement>('.when')!.hidden = true;
        });
        document.querySelectorAll<HTMLElement>('.pin-card[data-files]').forEach((card) => {
          const n = card.dataset.files!.split('|').reduce((sum, f) => sum + (files[f] || 0), 0);
          if (!n) return;
          card.querySelector('.pin-dl-n')!.textContent = fmt.format(n);
          card.querySelector<HTMLElement>('.pin-dl')!.hidden = false;
        });
      })
      .catch(() => (dlEl.textContent = fmt.format(Number(dlEl.dataset.fallback) + offset)));
  }

  // زر "عرض المزيد": يُظهر دفعة جديدة من التعريبات عند كل ضغطة
  const moreBtn = document.getElementById('latest-more');
  const grid = document.getElementById('latest-cards');
  if (moreBtn && grid) {
    const size = Number(grid.dataset.pageSize) || 30;
    const hiddenCards = () => [...grid.querySelectorAll<HTMLElement>(':scope > [hidden]')];
    const countEl = document.getElementById('more-count');
    // عدّاد صغير تحت الزر: "7 تعريبات أخرى"
    const updateCount = () => {
      const n = hiddenCards().length;
      if (!countEl) return;
      countEl.textContent = n === 0 ? '' : n === 1 ? 'تعريب واحد آخر' : n === 2 ? 'تعريبان آخران' : n <= 10 ? `${n} تعريبات أخرى` : `${n} تعريباً آخر`;
    };
    // يُكمل الصف الأخير حسب عدد الأعمدة في شاشة الزائر (مثلاً 15 → 16 على الجوال)
    const fillRow = () => {
      const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
      const shown = grid.children.length - hiddenCards().length;
      const missing = (cols - (shown % cols)) % cols;
      hiddenCards()
        .slice(0, missing)
        .forEach((c) => (c.hidden = false));
      document.getElementById('more-wrap')!.hidden = !hiddenCards().length;
      updateCount();
    };
    moreBtn.addEventListener('click', () => {
      hiddenCards()
        .slice(0, size)
        .forEach((c) => (c.hidden = false));
      fillRow();
    });
    fillRow();

    // التصفية بالنوع: تُظهر كل ألعاب النوع دفعة واحدة، و"الكل" يرجع للعرض بالصفحات
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.cat-chips .cat')];
    const cards = [...grid.children] as HTMLElement[];
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.toggle('on', c === chip));
        const cat = chip.dataset.cat;
        if (cat) {
          cards.forEach((c) => (c.hidden = !(c.dataset.cats || '').split('|').includes(cat)));
          document.getElementById('more-wrap')!.hidden = true;
        } else {
          cards.forEach((c, i) => (c.hidden = i >= size));
          fillRow();
        }
      }),
    );
  }


  // نافذة الاستكشاف: تُفتح من خانات الشريط أو برابط ‎#popular / #updates / #soon
  const hub = document.getElementById('hub') as HTMLDialogElement | null;
  if (hub) {
    const tabs = [...hub.querySelectorAll<HTMLButtonElement>('.hub-tab')];
    const panels = [...hub.querySelectorAll<HTMLElement>('.hub-panel')];
    const ink = hub.querySelector<HTMLElement>('.hub-ink')!;
    const names = tabs.map((t) => t.dataset.tab!);
    const moveInk = () => {
      const cur = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      if (!cur) return;
      ink.style.setProperty('--x', `${cur.offsetLeft}px`);
      ink.style.setProperty('--w', `${cur.offsetWidth}px`);
    };
    const show = (name: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === name)));
      panels.forEach((p) => p.classList.toggle('on', p.dataset.panel === name));
      hub.querySelector('.hub-body')!.scrollTop = 0;
      history.replaceState(null, '', `#${name}`);
      moveInk();
    };
    const open = (name: string) => {
      if (!hub.open) hub.showModal();
      show(name);
    };
    const close = () => {
      hub.close();
    };
    hub.addEventListener('close', () => history.replaceState(null, '', location.pathname + location.search));

    document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => open(b.dataset.open!)));
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab!)));
    hub.querySelector('[data-close]')!.addEventListener('click', close);
    // الضغط خارج النافذة يغلقها
    hub.addEventListener('click', (e) => {
      if (e.target === hub) close();
    });
    window.addEventListener('resize', moveInk);
    const fromHash = location.hash.slice(1);
    if (names.includes(fromHash)) open(fromHash);

    // تصفية آخر التحديثات
    const chips = [...hub.querySelectorAll<HTMLButtonElement>('.chip')];
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        chips.forEach((x) => x.classList.toggle('on', x === c));
        const f = c.dataset.filter;
        hub.querySelectorAll<HTMLElement>('.tl li').forEach((li) => (li.hidden = f !== 'all' && li.dataset.kind !== f));
      }),
    );

    // العدّ التنازلي لصدور الألعاب، وبعد الصدور تتغير الشارة إلى "صدرت · التعريب قيد العمل"
    const timers = [...hub.querySelectorAll<HTMLElement>('[data-countdown]')];
    const tick = () => {
      timers.forEach((el) => {
        const left = new Date(`${el.dataset.countdown}T00:00:00`).getTime() - Date.now();
        if (left <= 0) {
          el.hidden = true;
          const state = el.closest('.soon-card')?.querySelector('[data-state]');
          if (state) {
            state.textContent = 'صدرت · التعريب قيد العمل';
            state.classList.add('out');
          }
          return;
        }
        const u = { d: Math.floor(left / 864e5), h: Math.floor(left / 36e5) % 24, m: Math.floor(left / 6e4) % 60, s: Math.floor(left / 1e3) % 60 };
        for (const [k, v] of Object.entries(u)) el.querySelector(`[data-u="${k}"]`)!.textContent = String(v).padStart(2, '0');
      });
    };
    if (timers.length) {
      tick();
      setInterval(tick, 1000);
    }
  }
</script>
