  }
  /* عند مرور الفأرة: يضيء الإطار بتدرج الشعار، وتشتد الهالة، وترتفع البطاقة */
  .pin-card:hover .pin-frame {
    transform: translateY(-6px);
    background: conic-gradient(from 210deg, var(--accent), #8b95ff, var(--accent-2), var(--accent));
  }
  .pin-card:hover .pin-img {
    transform: scale(1.05);
  }
  .pin-card:hover .pin-glow {
    opacity: 0.9;
    transform: translateY(8px) scale(1.05);
  }
  /* الجوال: الأول بطاقة كبيرة وتحته بطاقتان صغيرتان (تظهر كلها دون سحب).
     الأخيرة في ترتيب زوجي تأخذ العرض كاملاً حتى لا تبقى وحدها في نصف صف */
  @media (max-width: 760px) {
    .pin-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .pin-card:first-child,
    .pin-card:last-child:nth-child(even) {
      grid-column: 1 / -1;
    }
    .pin-card .pin-glow {
      opacity: 0.3;
    }
    .pin-frame {
      border-radius: 16px;
    }
    .pin-in {
      border-radius: 14px;
    }
    .pin-glass {
      display: none;
    }
    .pin-dl {
      top: 8px;
      inset-inline-end: 8px;
      gap: 5px;
      padding: 3px 9px 3px 3px;
    }
    .pin-dl-ic {
      width: 19px;
      height: 19px;
    }
    .pin-dl-ic svg {
      width: 11px;
      height: 11px;
    }
    .pin-dl b {
      font-size: 0.8rem;
    }
    .pin-dl small {
      font-size: 0.66rem;
    }
    /* البطاقات الصغيرة: الرقم فقط */
    .pin-card:not(:first-child):not(:last-child:nth-child(even)) .pin-dl small {
      display: none;
    }
    .pin-m {
      display: block;
      position: absolute;
      inset: 0;
      background: linear-gradient(transparent 40%, rgb(5 6 12 / 0.92));
    }
    .pin-tag {
      position: absolute;
      top: 10px;
      inset-inline-start: 10px;
      padding: 3px 10px 2px;
      border-radius: 999px;
      background: var(--accent-2);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 800;
    }
    .pin-m-names {
      position: absolute;
      bottom: 10px;
      inset-inline: 12px;
      display: grid;
      line-height: 1.3;
    }
    .pin-m-names strong {
      font-size: 1rem;
      font-weight: 800;
      text-align: right;
    }
    .pin-m-names span {
      color: #c9cde6;
      font-size: 0.8rem;
    }
    /* البطاقات الصغيرة: بلا شارة، واسم أصغر في سطر واحد */
    .pin-card:not(:first-child):not(:last-child:nth-child(even)) .pin-tag {
      display: none;
    }
    .pin-card:not(:first-child):not(:last-child:nth-child(even)) .pin-m-names {
      bottom: 7px;
      inset-inline: 9px;
    }
    .pin-card:not(:first-child):not(:last-child:nth-child(even)) .pin-m-names strong {
      font-size: 0.8rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .pin-card:not(:first-child):not(:last-child:nth-child(even)) .pin-m-names span {
      font-size: 0.7rem;
    }
  }

  /* جديد التعريبات بعرض الصفحة: 5 في الصف على أغلب الشاشات */
  .latest {
    padding-top: 40px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }
  /* الشاشات الكبيرة: 5 بطاقات في الصف دائماً، حتى لا تصغر البطاقات وتنقطع الأسماء */
  @media (min-width: 1200px) {
    .cards {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }


  /* منطقة البطاقتين: هادئة ومضغوطة — صف واحد في كل بطاقة */
  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 28px;
  }
  .soft-divider-end {
    margin-top: 32px;
  }
  .duo-divider {
    margin-top: 4px; /* قسم "جديد التعريبات" فوقه يترك مسافة كافية أصلاً */
  }
  .duo-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border-radius: 16px;
    color: inherit;
    background: var(--card);
    border: 1px solid var(--border);
    transition:
      border-color 0.25s,
      background 0.25s;
  }
  .duo-body {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 3px;
  }
  .duo-title {
    font-size: 1.02rem;
    font-weight: 800;
    line-height: 1.35;
  }
  .duo-text {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .duo-btn {
    flex-shrink: 0;
    padding: 0.45em 1.1em;
    font-size: 0.88rem;
  }

  /* تعريبات لايف */
  .duo-live {
    background:
      linear-gradient(90deg, transparent 40%, rgb(25 195 214 / 0.07)),
      var(--card);
  }
  .duo-live:hover {
    border-color: rgb(25 195 214 / 0.6);
  }
  .duo-thumb {
    flex-shrink: 0;
    width: 104px;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .duo-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 80%;
  }
  .duo-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--accent);
  }
  .duo-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-2);
  }

  /* ديسكورد */
  .duo-discord {
    background:
      linear-gradient(90deg, transparent 40%, rgb(88 101 242 / 0.1)),
      var(--card);
  }
  .duo-discord:hover {
    border-color: rgb(88 101 242 / 0.7);
  }
  .duo-ico {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #5865f2;
    color: #fff;
  }
  .duo-btn-discord {
    background: rgb(88 101 242 / 0.18);
    border-color: rgb(88 101 242 / 0.5);
  }
  .duo-discord:hover .duo-btn-discord {
    background: #5865f2;
    color: #fff;
  }

  @media (max-width: 900px) {
    .duo {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
  @media (max-width: 480px) {
    .duo-thumb {
      width: 76px;
    }
    .duo-text {
      display: none;
    }
  }

  .how-head {
    text-align: center;
    margin-bottom: 28px;
  }
  .how-head h2 {
    margin: 0 0 6px;
  }
  .how-head p {
    margin: 0;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    counter-reset: none;
  }
  .step {
    position: relative;
    text-align: center;
    padding: 30px 22px 26px;
    background:
      radial-gradient(circle at 50% 0%, rgb(25 195 214 / 0.12), transparent 65%),
      var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  /* سهم يصل بين الخطوات (الصفحة من اليمين لليسار) */
  .step:not(:last-child)::after {
    content: '‹';
    position: absolute;
    top: 50%;
    left: -17px;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 1.4rem;
    line-height: 1;
    z-index: 1;
    /* حتى لا يقلب المتصفح اتجاه السهم في الصفحة العربية */
    direction: ltr;
    unicode-bidi: isolate;
  }
  .num {
    position: absolute;
    top: 14px;
    inset-inline-start: 16px;
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ico {
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    color: #0b0d17;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 10px 30px rgb(25 195 214 / 0.25);
  }
  .step h3 {
    font-size: 1.2rem;
    margin: 0 0 6px;
  }
  .step p {
    margin: 0;
  }
  @media (max-width: 800px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .step:not(:last-child)::after {
      content: '⌄';
      top: auto;
      bottom: -21px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 1.1rem;
    }
  }

  .articles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .article {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    transition: border-color 0.2s, transform 0.2s;
  }
  .article:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .article h3 {
    font-size: 1.2rem;
    margin: 4px 0 0;
  }
  .article p {
    margin: 0;
  }
  .article time {
    margin-top: auto;
    font-size: 0.85rem;
  }

  @media (max-width: 800px) {
    .articles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* الجوال والشاشات الصغيرة: الإحصائيات 4 أرقام بلا أيقونات فوق حافة البانر، وتحتها زر تعريبات لايف */
  @media (max-width: 760px) {
    .stats-wrap {
      margin-top: -16px;
    }
    .stats-wrap .stats-strip {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      padding: 10px 6px;
      border-radius: var(--radius);
    }
    .stats-wrap .stats-strip li {
      flex-direction: column;
      justify-content: center;
      gap: 3px;
      text-align: center;
      font-size: 0.74rem;
      line-height: 1.2;
    }
    .stats-wrap .s-ico,
    .stats-wrap .stats-strip .colon,
    .stats-wrap .stats-strip .s-live {
      display: none;
    }
    .stats-wrap .stats-strip strong,
    .stats-wrap .stats-strip time {
      order: 1;
      font-size: 1.1rem;
    }
    .stats-wrap .stats-strip li > span:not(.s-ico) {
      order: 2;
    }
    .stats-wrap .stats-strip li + li::before {
      inset-inline-start: 0;
      height: 32px;
    }
    .stats-wrap .stats-strip {
      padding: 12px 6px;
    }
    .live-slim {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 10px;
      padding: 9px 12px;
      border-radius: 999px;
      border: 1px solid rgb(224 52 79 / 0.35);
      background: rgb(224 52 79 / 0.1);
      color: var(--text);
      font-size: 0.86rem;
      font-weight: 700;
      text-decoration: none;
    }
    .live-slim-go {
      color: var(--accent);
      font-size: 1.1rem;
      line-height: 1;
    }
    :global(body:has(.stats-wrap) .hero .dots) {
      bottom: 44px;
    }
  }
  @media (max-width: 560px) {
    /* الجوال: بطاقتان في كل صف */
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    /* شريط الإحصائيات على الجوال: صف واحد مضغوط من 4 أعمدة (أيقونة، رقم، كلمة) */
    .stats-strip {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      margin-top: 20px;
      padding: 12px 6px;
      border-radius: var(--radius);
    }
    .stats-strip li {
      flex-direction: column;
      gap: 4px;
      text-align: center;
      font-size: 0.72rem;
      line-height: 1.2;
    }
    .s-ico {
      width: 28px;
      height: 28px;
      border-radius: 9px;
      box-shadow: none;
    }
    .s-ico :global(svg) {
      width: 15px;
      height: 15px;
    }
    .stats-strip strong,
    .stats-strip time {
      font-size: 1rem;
    }
    /* "آخر إضافة": الوقت قبل الكلمة، بدون النقطتين */
    .stats-strip time {
      order: 1;
    }
    .stats-strip li > span:not(.s-ico) {
      order: 2;
    }
    .stats-strip .colon {
      display: none;
    }
    .stats-strip li + li::before {
      inset-inline-start: 0;
      height: 36px;
    }
    .articles {
      grid-template-columns: 1fr;
    }
  }

  /* "كل التعريبات" بجانب العنوان: زر واضح بدل رابط باهت */
  .section-head .more-pill {
    margin-inline-start: auto;
    padding: 7px 16px;
    border: 1px solid rgb(25 195 214 / 0.4);
    border-radius: 999px;
    background: rgb(25 195 214 / 0.08);
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .section-head .more-pill:hover {
    background: rgb(25 195 214 / 0.16);
    border-color: var(--accent);
    color: var(--accent);
  }
  /* أزرار التصفية بالنوع فوق "أحدث الألعاب المعرّبة" */
  .cat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: -8px 0 22px;
  }
  .cat {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 15px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
    color: var(--muted);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .cat span {
    padding: 0 7px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    font-size: 0.75rem;
  }
  .cat:hover {
    color: var(--text);
    border-color: rgb(255 255 255 / 0.2);
  }
  .cat.on {
    border-color: transparent;
    background: linear-gradient(135deg, var(--accent), #7de3ee);
    color: #0b0d17;
  }
  .cat.on span {
    background: rgb(0 0 0 / 0.15);
  }
  /* الجوال: الأزرار صف واحد يُسحب أفقياً */
  @media (max-width: 760px) {
    .cat-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: -16px;
      padding-inline: 16px;
    }
    .cat {
      flex-shrink: 0;
      font-size: 0.82rem;
    }
  }

  /* ═════ خانات الشريط القابلة للضغط (تفتح نافذة الاستكشاف) ═════ */
  .s-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 7px 12px;
    margin: -7px -12px;
    border: 0;
    border-radius: 16px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.25s;
  }
  .s-btn:hover,
  .s-btn:focus-visible {
    background: rgb(255 255 255 / 0.055);
  }
  .s-btn .s-ico {
    position: relative;
    transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .s-btn:hover .s-ico {
    transform: translateY(-2px) rotate(-6deg) scale(1.07);
  }
  /* سطر واحد بنفس سماكة الشريط القديم: "4.9K تحميل · الأكثر تحميلاً ‹" */
  .s-txt {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .s-txt small::before {
    content: '';
    width: 1px;
    height: 14px;
    margin-inline-end: 5px;
    background: var(--border);
  }
  @media (max-width: 1300px) {
    /* الشاشات الأصغر: يبقى السهم فقط */
    .s-txt small {
      font-size: 0;
      gap: 0;
    }
    .s-txt small i {
      font-size: 1rem;
    }
  }
  .s-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .s-txt small {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.8;
    transition: color 0.25s, opacity 0.25s;
  }
  .s-txt small i {
    font-style: normal;
    color: var(--accent);
    transition: transform 0.25s;
  }
  .s-btn:hover small {
    color: var(--accent);
    opacity: 1;
  }
  .s-btn:hover small i {
    transform: translateX(-4px);
  }
  .ico-hot {
    position: absolute;
    top: -3px;
    inset-inline-end: -3px;
    width: 10px;
    height: 10px;
    border: 2px solid var(--card);
    box-sizing: content-box;
  }

  /* ═════ نافذة الاستكشاف ═════ */
  :global(html:has(.hub[open])) {
    overflow: hidden;
  }
  .hub {
    width: min(900px, calc(100% - 32px));
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: visible;
  }
  .hub::backdrop {
    background: rgb(4 5 12 / 0.72);
    backdrop-filter: blur(8px);
  }
  .hub[open] {
    animation: hub-pop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.15);
  }
  .hub[open]::backdrop {
    animation: hub-fade 0.3s ease;
  }
  @keyframes hub-pop {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
  }
  @keyframes hub-fade {
    from {
      opacity: 0;
    }
  }
  .hub-in {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: calc(86vh / var(--zoom));
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 26px;
    background:
      radial-gradient(120% 60% at 100% 0%, rgb(25 195 214 / 0.1), transparent 60%),
      radial-gradient(90% 50% at 0% 0%, rgb(224 52 79 / 0.1), transparent 60%),
      #11142a;
    box-shadow: 0 40px 100px rgb(0 0 0 / 0.65);
    overflow: hidden;
  }
  /* خيط متدرج بألوان الشعار أعلى النافذة */
  .hub-in::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-2) 30%, var(--accent) 70%, transparent);
  }
  .hub-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px 6px;
  }
  .hub-tabs {
    position: relative;
    display: flex;
    flex: 1;
    gap: 4px;
    padding: 5px;
    border: 1px solid rgb(255 255 255 / 0.06);
    border-radius: 16px;
    background: rgb(0 0 0 / 0.25);
  }
  .hub-tab {
    position: relative;
    z-index: 1;
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 10px;
    border: 0;
    border-radius: 12px;
    background: none;
    color: var(--muted);
    font: inherit;
    font-weight: 700;
    font-size: 0.98rem;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.3s;
  }
  .hub-tab:hover {
    color: var(--text);
  }
  .hub-tab[aria-selected='true'] {
    color: #0b0d17;
  }
  .hub-count {
    min-width: 20px;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--accent-2);
    color: #fff;
    font-size: 0.72rem;
    line-height: 1.5;
  }
  /* خلفية التبويب النشط تنزلق بين التبويبات */
  .hub-ink {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: var(--x, 5px);
    width: var(--w, 0);
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), #7de3ee);
    box-shadow: 0 6px 22px rgb(25 195 214 / 0.35);
    transition:
      left 0.4s cubic-bezier(0.3, 1.3, 0.5, 1),
      width 0.4s cubic-bezier(0.3, 1.3, 0.5, 1);
  }
  .hub-x {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 14px;
