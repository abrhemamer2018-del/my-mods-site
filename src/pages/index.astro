---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TranslationCard from '../components/TranslationCard.astro';
import { getArticles, getTranslations, formatDate } from '../lib/utils';
import Icon from '../components/Icon.astro';
import { SITE, SOCIAL } from '../config';
import pinnedData from '../data/pinned.json';
import heroData from '../data/hero.json';

const translations = await getTranslations();
// التعريبات المثبتة: تُختار وتُرتَّب من لوحة التحكم (نافذة "التعريبات المثبتة")، مستقلة عن البانر
const pinned = pinnedData.slugs
  .map((slug) => translations.find((t) => t.id === slug))
  .filter((t) => t !== undefined);
// البانر: الألعاب المختارة من لوحة التحكم (نافذة "البانر الرئيسي") بالترتيب.
// إن كانت القائمة فارغة: التعريبات المميزة أولاً، ثم نكمل بالأحدث حتى 5 شرائح
const chosenHero = heroData.slugs
  .map((slug) => translations.find((t) => t.id === slug))
  .filter((t) => t !== undefined);
const featured = translations.filter((t) => t.data.featured);
const HERO_MAX = 5;
const heroItems = chosenHero.length
  ? chosenHero
  : [
      ...featured,
      ...translations.filter((t) => !t.data.featured).slice(0, Math.max(0, HERO_MAX - featured.length)),
    ].slice(0, Math.max(HERO_MAX, featured.length));
// جديد التعريبات بعرض الصفحة: تظهر أول 30 (6 صفوف من 5)، و"عرض المزيد" يُظهر 30 أخرى عند كل ضغطة
const PAGE_SIZE = 30;

// قسم المقالات يظهر فقط عند وجود 3 مقالات أو أكثر، حتى لا يبدو الموقع غير نشط
const ARTICLES_MIN = 3;
const allArticles = await getArticles();
const articles = allArticles.length >= ARTICLES_MIN ? allArticles.slice(0, 3) : [];

const lastAdded = translations[0]?.data.releaseDate;
const discord = SOCIAL.find((s) => s.icon === 'discord');
---

<BaseLayout>
  {/* العنوان الرئيسي للصفحة لمحركات البحث وقارئات الشاشة (مخفي بصرياً) */}
  <h1 class="sr-only">موقع {SITE.name} — {SITE.tagline}</h1>
  {heroItems.length > 0 && <Hero items={heroItems} />}

  {/* تعريبات مثبتة: تُختار من لوحة التحكم ← "التعريبات المثبتة".
      يختفي القسم تلقائياً إن لم يوجد أي تعريب مثبت */}
  {
    pinned.length > 0 && (
      <section class="container pinned-sec">
        <div class="section-head">
          <h2>تعريبات مثبتة</h2>
        </div>
        <div class="pin-grid">
          {pinned.map((t) => (
            <a href={`/translations/${t.id}/`} class="pin-card">
              {/* هالة ضوء بألوان غلاف اللعبة نفسها تنعكس تحت البطاقة */}
              <Image class="pin-glow" src={t.data.cover} alt="" width={320} aria-hidden="true" />
              {/* إطار متدرج بألوان الشعار، والغلاف كاملاً بنسبته 16:9 بلا قص */}
              <span class="pin-frame">
                <span class="pin-in">
                  <Image class="pin-img" src={t.data.cover} alt={`تعريب لعبة ${t.data.titleAr} (${t.data.title})`} width={760} />
                  {/* لوحة زجاجية للاسم */}
                  <span class="pin-glass">
                    <span class="pin-flag" aria-label="مثبت">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 3a1 1 0 0 1 .7 1.7L15 6.4v4.2l2.6 2.6a1 1 0 0 1-.7 1.8H13v5.5a1 1 0 0 1-2 0V15H7.1a1 1 0 0 1-.7-1.8L9 10.6V6.4L7.3 4.7A1 1 0 0 1 8 3z" /></svg>
                    </span>
                    <span class="pin-names">
                      <strong dir="ltr">{t.data.title}</strong>
                      <span>{t.data.titleAr}</span>
                    </span>
                  </span>
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {/* شريط الإحصائيات: سطر واحد صغير تحت البانر */}
  <div class="container">
    <ul class="stats-strip">
      <li>
        <span class="s-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5" /><path d="M7 11v3M5.5 12.5h3M15.5 12h.01M18 13.5h.01" /></svg></span>
        <strong>{translations.length}</strong>
        <span>تعريب</span>
      </li>
      <li>
        <span class="s-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg></span>
        <strong dir="ltr" id="downloads-count" data-offset={SITE.downloadsOffset}>…</strong>
        <span>تحميل</span>
      </li>
      {
        lastAdded && (
          <li>
            <span class="s-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>
            <span>آخر إضافة<span class="colon">:</span></span>
            <time datetime={lastAdded.toISOString()} data-ago="" title={formatDate(lastAdded)}>
              {formatDate(lastAdded)}
            </time>
          </li>
        )
      }
      <li>
        <span class="s-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg></span>
        <strong>100%</strong>
        <span>مجانية</span>
      </li>
    </ul>
  </div>

  {/* جديد التعريبات بعرض الصفحة كاملة */}
  <section class="container section latest">
    <div class="section-head">
      <h2>جديد التعريبات</h2>
      <a href="/translations/">المزيد ‹</a>
    </div>
    <div class="cards" id="latest-cards" data-page-size={PAGE_SIZE}>
      {translations.map((t, i) => <TranslationCard item={t} hidden={i >= PAGE_SIZE} />)}
    </div>
    {
      translations.length > PAGE_SIZE && (
        <div class="more-wrap" id="more-wrap">
          {/* خط فاصل يمر خلف الزر ويربطه بنهاية القائمة */}
          <button type="button" id="latest-more" class="more-bar">
            عرض المزيد
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <span class="more-count muted" id="more-count" />
        </div>
      )
    }
  </section>

  {/* شريط ديسكورد بعرض الصفحة */}
  {
    discord && (
      <section class="container">
        <div class="discord-band">
          <span class="d-ico">
            <Icon name="discord" size={34} />
          </span>
          <div class="d-text">
            <h2>عندك لعبة تتمنى تعريبها؟</h2>
            <p class="muted">اطلبها في ديسكورد، وتابع أخبار التعريبات القادمة أولاً بأول.</p>
          </div>
          <a href={discord.url} class="btn btn-primary" target="_blank" rel="noopener">
            انضم إلى ديسكورد
          </a>
        </div>
      </section>
    )
  }

  {/* كيف أثبّت التعريب؟ ثلاث خطوات تطمئن الزائر الجديد أن التثبيت سهل */}
  <section class="container section how" id="how">
    <div class="how-head">
      <h2>كيف أثبّت التعريب؟</h2>
      <p class="muted">ثلاث خطوات فقط، وكل تعريباتنا تعمل بنفس الطريقة.</p>
    </div>
    <ol class="steps">
      <li class="step">
        <span class="num">1</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg>
        </span>
        <h3>حمّل التعريب</h3>
        <p class="muted">اضغط "تحميل مباشر" في صفحة اللعبة، وفك ضغط الملف.</p>
      </li>
      <li class="step">
        <span class="num">2</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z" /></svg>
        </span>
        <h3>شغّل أداة التثبيت</h3>
        <p class="muted">اضغط "تثبيت"، والأداة تجد مجلد اللعبة تلقائياً.</p>
      </li>
      <li class="step">
        <span class="num">3</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5" /><path d="M7 11v3M5.5 12.5h3M15.5 12h.01M18 13.5h.01" /></svg>
        </span>
        <h3>العب بالعربية</h3>
        <p class="muted">شغّل اللعبة، وستجدها بالعربية مباشرة.</p>
      </li>
    </ol>
  </section>

  {
    articles.length > 0 && (
      <section class="container section">
        <div class="section-head">
          <h2>أحدث المقالات والدروس</h2>
          <a href="/articles/">المزيد ‹</a>
        </div>
        <div class="articles">
          {articles.map((a) => (
            <a href={`/articles/${a.id}/`} class="panel article">
              <span class="badge">{a.data.kind === 'lesson' ? 'درس' : 'مقال'}</span>
              <h3>{a.data.title}</h3>
              <p class="muted">{a.data.description}</p>
              <time class="muted" datetime={a.data.date.toISOString()}>
                {formatDate(a.data.date)}
              </time>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* شريط الإحصائيات تحت البانر */
  .stats-strip {
    list-style: none;
    margin: 40px 0 0;
    padding: 16px 28px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    align-items: center;
    gap: 14px 32px;
    background:
      linear-gradient(90deg, rgb(224 52 79 / 0.07), transparent 35%, transparent 65%, rgb(25 195 214 / 0.08)),
      var(--card);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }
  .stats-strip li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* أيقونة صغيرة بتدرج الشعار قبل كل عنصر */
  .s-ico {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 12px;
    color: #0b0d17;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 6px 18px rgb(25 195 214 / 0.2);
  }
  .stats-strip strong,
  .stats-strip time {
    color: var(--text);
    font-weight: 800;
    font-size: 1.45rem;
    line-height: 1;
  }
  .stats-strip time {
    font-size: 1.2rem;
    color: var(--accent);
  }
  .stats-strip li + li {
    position: relative;
  }
  .stats-strip li + li::before {
    content: '';
    position: absolute;
    inset-inline-start: -16px;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 28px;
    background: var(--border);
  }

  /* تعريبات مثبتة: بطاقات مضيئة — إطار متدرج بألوان الشعار، ولوحة زجاجية، وهالة ضوء بألوان الغلاف */
  .pinned-sec {
    padding-top: 32px;
  }
  /* على الكمبيوتر: البانر يتكيف مع ارتفاع الشاشة حتى تظهر التعريبات المثبتة كاملة في أول شاشة */
  @media (min-width: 761px) {
    :global(body:has(.pinned-sec) .hero) {
      height: clamp(380px, calc(100vh - 430px), 640px);
    }
  }
  .pin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 28px;
  }
  .pin-card {
    position: relative;
    display: block;
    isolation: isolate;
  }
  .pin-card .pin-glow {
    position: absolute;
    inset: 16% 4% -14%;
    width: 92%;
    height: 96%;
    object-fit: cover;
    filter: blur(34px) saturate(1.9);
    opacity: 0.45;
    z-index: -1;
    transition:
      opacity 0.35s,
      transform 0.35s;
  }
  .pin-frame {
    position: relative;
    display: block;
    padding: 2px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgb(25 195 214 / 0.35), rgb(255 255 255 / 0.06), rgb(224 52 79 / 0.35));
    transition:
      transform 0.35s,
      background 0.35s;
  }
  .pin-in {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
  }
  .pin-in .pin-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .pin-glass {
    position: absolute;
    bottom: 12px;
    inset-inline-start: 12px;
    max-width: calc(100% - 24px);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px 8px 10px;
    border-radius: 14px;
    background: rgb(11 13 23 / 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .pin-flag {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--accent-2), #ff6b81);
    transform: rotate(35deg);
  }
  .pin-names {
    min-width: 0;
    display: grid;
    line-height: 1.35;
  }
  .pin-names strong {
    font-size: 1rem;
    font-weight: 800;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pin-names span {
    color: #c9cde6;
    font-size: 0.82rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* عند مرور الفأرة: يضيء الإطار بتدرج الشعار، وتشتد الهالة، وترتفع البطاقة */
  .pin-card:hover .pin-frame {
    transform: translateY(-6px);
    background: conic-gradient(from 210deg, var(--accent), #8b95ff, var(--accent-2), var(--accent));
  }
  .pin-card:hover .pin-img {
    transform: scale(1.05);
  }
  .pin-card:hover .pin-glow {
    opacity: 0.9;
    transform: translateY(8px) scale(1.05);
  }
  /* القسم للكمبيوتر فقط: يُخفى على الجوال والشاشات الصغيرة */
  @media (max-width: 760px) {
    .pinned-sec {
      display: none;
    }
  }

  /* جديد التعريبات بعرض الصفحة: 5 في الصف على أغلب الشاشات */
  .latest {
    padding-top: 40px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }


  /* شريط ديسكورد بعرض الصفحة */
  .discord-band {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 22px 28px;
    border: 1px solid rgb(88 101 242 / 0.45);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 100% 50%, rgb(88 101 242 / 0.3), transparent 55%),
      var(--card);
  }
  .d-ico {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    background: #5865f2;
    color: #fff;
  }
  .d-text {
    flex: 1;
  }
  .d-text h2 {
    font-size: 1.3rem;
    margin: 0 0 4px;
  }
  .d-text p {
    margin: 0;
  }
  .discord-band .btn {
    flex-shrink: 0;
  }

  .how-head {
    text-align: center;
    margin-bottom: 28px;
  }
  .how-head h2 {
    margin: 0 0 6px;
  }
  .how-head p {
    margin: 0;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    counter-reset: none;
  }
  .step {
    position: relative;
    text-align: center;
    padding: 30px 22px 26px;
    background:
      radial-gradient(circle at 50% 0%, rgb(25 195 214 / 0.12), transparent 65%),
      var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  /* سهم يصل بين الخطوات (الصفحة من اليمين لليسار) */
  .step:not(:last-child)::after {
    content: '‹';
    position: absolute;
    top: 50%;
    left: -17px;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 1.4rem;
    line-height: 1;
    z-index: 1;
    /* حتى لا يقلب المتصفح اتجاه السهم في الصفحة العربية */
    direction: ltr;
    unicode-bidi: isolate;
  }
  .num {
    position: absolute;
    top: 14px;
    inset-inline-start: 16px;
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ico {
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    color: #0b0d17;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 10px 30px rgb(25 195 214 / 0.25);
  }
  .step h3 {
    font-size: 1.2rem;
    margin: 0 0 6px;
  }
  .step p {
    margin: 0;
  }
  @media (max-width: 800px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .step:not(:last-child)::after {
      content: '⌄';
      top: auto;
      bottom: -21px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 1.1rem;
    }
  }

  .articles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .article {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    transition: border-color 0.2s, transform 0.2s;
  }
  .article:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .article h3 {
    font-size: 1.2rem;
    margin: 4px 0 0;
  }
  .article p {
    margin: 0;
  }
  .article time {
    margin-top: auto;
    font-size: 0.85rem;
  }

  @media (max-width: 800px) {
    .articles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .discord-band {
      flex-direction: column;
      text-align: center;
      padding: 24px 20px;
    }
  }
  @media (max-width: 560px) {
    /* الجوال: بطاقتان في كل صف */
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    /* شريط الإحصائيات على الجوال: صف واحد مضغوط من 4 أعمدة (أيقونة، رقم، كلمة) */
    .stats-strip {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      margin-top: 20px;
      padding: 12px 6px;
      border-radius: var(--radius);
    }
    .stats-strip li {
      flex-direction: column;
      gap: 4px;
      text-align: center;
      font-size: 0.72rem;
      line-height: 1.2;
    }
    .s-ico {
      width: 28px;
      height: 28px;
      border-radius: 9px;
      box-shadow: none;
    }
    .s-ico :global(svg) {
      width: 15px;
      height: 15px;
    }
    .stats-strip strong,
    .stats-strip time {
      font-size: 1rem;
    }
    /* "آخر إضافة": الوقت قبل الكلمة، بدون النقطتين */
    .stats-strip time {
      order: 1;
    }
    .stats-strip li > span:not(.s-ico) {
      order: 2;
    }
    .stats-strip .colon {
      display: none;
    }
    .stats-strip li + li::before {
      inset-inline-start: 0;
      height: 36px;
    }
    .articles {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // عدد التحميلات الحقيقي من GitHub (عبر /api/downloads)
  const dlEl = document.getElementById('downloads-count');
  if (dlEl) {
    const offset = Number(dlEl.dataset.offset) || 0;
    const fmt = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
    fetch('/api/downloads')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then(({ total }) => (dlEl.textContent = fmt.format(total + offset)))
      .catch(() => (dlEl.textContent = offset ? fmt.format(offset) : '—'));
  }

  // زر "عرض المزيد": يُظهر دفعة جديدة من التعريبات عند كل ضغطة
  const moreBtn = document.getElementById('latest-more');
  const grid = document.getElementById('latest-cards');
  if (moreBtn && grid) {
    const size = Number(grid.dataset.pageSize) || 30;
    const hiddenCards = () => [...grid.querySelectorAll<HTMLElement>(':scope > [hidden]')];
    const countEl = document.getElementById('more-count');
    // عدّاد صغير تحت الزر: "7 تعريبات أخرى"
    const updateCount = () => {
      const n = hiddenCards().length;
      if (!countEl) return;
      countEl.textContent = n === 0 ? '' : n === 1 ? 'تعريب واحد آخر' : n === 2 ? 'تعريبان آخران' : n <= 10 ? `${n} تعريبات أخرى` : `${n} تعريباً آخر`;
    };
    // يُكمل الصف الأخير حسب عدد الأعمدة في شاشة الزائر (مثلاً 15 → 16 على الجوال)
    const fillRow = () => {
      const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
      const shown = grid.children.length - hiddenCards().length;
      const missing = (cols - (shown % cols)) % cols;
      hiddenCards()
        .slice(0, missing)
        .forEach((c) => (c.hidden = false));
      if (!hiddenCards().length) document.getElementById('more-wrap')?.remove();
      updateCount();
    };
    moreBtn.addEventListener('click', () => {
      hiddenCards()
        .slice(0, size)
        .forEach((c) => (c.hidden = false));
      fillRow();
    });
    fillRow();
  }

</script>
