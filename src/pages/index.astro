---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TranslationCard from '../components/TranslationCard.astro';
import { getArticles, getTranslations, formatDate } from '../lib/utils';
import Icon from '../components/Icon.astro';
import { SITE, SOCIAL } from '../config';

const translations = await getTranslations();
const featured = translations.filter((t) => t.data.featured);
// البانر: التعريبات المميزة أولاً، ثم نكمل بالأحدث حتى 5 شرائح
const HERO_MAX = 5;
const heroItems = [
  ...featured,
  ...translations.filter((t) => !t.data.featured).slice(0, Math.max(0, HERO_MAX - featured.length)),
].slice(0, Math.max(HERO_MAX, featured.length));
// جديد التعريبات بعرض الصفحة: تظهر أول 15 (3 صفوف من 5)، و"عرض المزيد" يُظهر 15 أخرى عند كل ضغطة
const PAGE_SIZE = 15;

// قسم المقالات يظهر فقط عند وجود 3 مقالات أو أكثر، حتى لا يبدو الموقع غير نشط
const ARTICLES_MIN = 3;
const allArticles = await getArticles();
const articles = allArticles.length >= ARTICLES_MIN ? allArticles.slice(0, 3) : [];

const lastAdded = translations[0]?.data.releaseDate;
const discord = SOCIAL.find((s) => s.icon === 'discord');
---

<BaseLayout>
  {/* العنوان الرئيسي للصفحة لمحركات البحث وقارئات الشاشة (مخفي بصرياً) */}
  <h1 class="sr-only">{SITE.name} — {SITE.tagline}</h1>
  {heroItems.length > 0 && <Hero items={heroItems} />}

  {/* شريط الإحصائيات: سطر واحد صغير تحت البانر */}
  <div class="container">
    <ul class="stats-strip">
      <li>
        <strong>{translations.length}</strong>
        <span>تعريب</span>
      </li>
      <li>
        <strong dir="ltr" id="downloads-count" data-offset={SITE.downloadsOffset}>…</strong>
        <span>تحميل</span>
      </li>
      {
        lastAdded && (
          <li>
            <span>آخر إضافة:</span>
            <time datetime={lastAdded.toISOString()} data-ago="" title={formatDate(lastAdded)}>
              {formatDate(lastAdded)}
            </time>
          </li>
        )
      }
      <li>
        <strong>100%</strong>
        <span>مجانية</span>
      </li>
    </ul>
  </div>

  {/* جديد التعريبات بعرض الصفحة كاملة */}
  <section class="container section latest">
    <div class="section-head">
      <h2>جديد التعريبات</h2>
      <a href="/translations/">المزيد ‹</a>
    </div>
    <div class="cards" id="latest-cards" data-page-size={PAGE_SIZE}>
      {translations.map((t, i) => <TranslationCard item={t} hidden={i >= PAGE_SIZE} />)}
    </div>
    {
      translations.length > PAGE_SIZE && (
        <div class="more-wrap" id="more-wrap">
          {/* خط فاصل يمر خلف الزر ويربطه بنهاية القائمة */}
          <button type="button" id="latest-more" class="more-bar">
            عرض المزيد
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <span class="more-count muted" id="more-count" />
        </div>
      )
    }
  </section>

  {/* شريط ديسكورد بعرض الصفحة */}
  {
    discord && (
      <section class="container">
        <div class="discord-band">
          <span class="d-ico">
            <Icon name="discord" size={34} />
          </span>
          <div class="d-text">
            <h2>عندك لعبة تتمنى تعريبها؟</h2>
            <p class="muted">اطلبها في ديسكورد، وتابع أخبار التعريبات القادمة أولاً بأول.</p>
          </div>
          <a href={discord.url} class="btn btn-primary" target="_blank" rel="noopener">
            انضم إلى ديسكورد
          </a>
        </div>
      </section>
    )
  }

  {/* كيف أثبّت التعريب؟ ثلاث خطوات تطمئن الزائر الجديد أن التثبيت سهل */}
  <section class="container section how" id="how">
    <div class="how-head">
      <h2>كيف أثبّت التعريب؟</h2>
      <p class="muted">ثلاث خطوات فقط، وكل تعريباتنا تعمل بنفس الطريقة.</p>
    </div>
    <ol class="steps">
      <li class="step">
        <span class="num">1</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" /></svg>
        </span>
        <h3>حمّل التعريب</h3>
        <p class="muted">اضغط "تحميل مباشر" في صفحة اللعبة، وفك ضغط الملف.</p>
      </li>
      <li class="step">
        <span class="num">2</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z" /></svg>
        </span>
        <h3>شغّل أداة التثبيت</h3>
        <p class="muted">اضغط "تثبيت"، والأداة تجد مجلد اللعبة تلقائياً.</p>
      </li>
      <li class="step">
        <span class="num">3</span>
        <span class="ico">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5" /><path d="M7 11v3M5.5 12.5h3M15.5 12h.01M18 13.5h.01" /></svg>
        </span>
        <h3>العب بالعربية</h3>
        <p class="muted">شغّل اللعبة، وستجدها بالعربية مباشرة.</p>
      </li>
    </ol>
  </section>

  {
    articles.length > 0 && (
      <section class="container section">
        <div class="section-head">
          <h2>أحدث المقالات والدروس</h2>
          <a href="/articles/">المزيد ‹</a>
        </div>
        <div class="articles">
          {articles.map((a) => (
            <a href={`/articles/${a.id}/`} class="panel article">
              <span class="badge">{a.data.kind === 'lesson' ? 'درس' : 'مقال'}</span>
              <h3>{a.data.title}</h3>
              <p class="muted">{a.data.description}</p>
              <time class="muted" datetime={a.data.date.toISOString()}>
                {formatDate(a.data.date)}
              </time>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* شريط الإحصائيات تحت البانر */
  .stats-strip {
    list-style: none;
    margin: 28px 0 0;
    padding: 14px 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 40px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }
  .stats-strip li {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .stats-strip strong,
  .stats-strip time {
    color: var(--accent);
    font-weight: 800;
    font-size: 1.15rem;
  }
  .stats-strip li + li {
    position: relative;
  }
  .stats-strip li + li::before {
    content: '';
    position: absolute;
    inset-inline-start: -20px;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border);
  }

  /* جديد التعريبات بعرض الصفحة: 5 في الصف على أغلب الشاشات */
  .latest {
    padding-top: 36px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }
  /* "عرض المزيد": زر في منتصف خط فاصل يبهت عند طرفيه، فيربط الزر بنهاية القائمة */
  .more-wrap {
    position: relative;
    margin-top: 28px;
    display: grid;
    justify-items: center;
    gap: 10px;
  }
  .more-wrap::before {
    content: '';
    position: absolute;
    top: 24px; /* منتصف الزر */
    inset-inline: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(25 195 214 / 0.85) 18%, rgb(25 195 214 / 0.85) 82%, transparent);
    opacity: 0.9;
  }
  .more-count {
    font-size: 0.85rem;
  }
  .more-count:empty {
    display: none;
  }
  .more-bar {
    position: relative;
    width: min(300px, 100%);
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 24px;
    font: inherit;
    font-weight: 700;
    color: var(--accent);
    /* خلفية صلبة حتى يقطع الزر الخط الفاصل خلفه */
    background: var(--bg);
    box-shadow: inset 0 0 0 100px rgb(25 195 214 / 0.06);
    border: 1px solid rgb(25 195 214 / 0.35);
    border-radius: 999px;
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .more-bar:hover {
    box-shadow: inset 0 0 0 100px rgb(25 195 214 / 0.14);
    border-color: var(--accent);
  }
  .more-bar svg {
    transition: transform 0.2s;
  }
  .more-bar:hover svg {
    transform: translateY(2px);
  }

  /* شريط ديسكورد بعرض الصفحة */
  .discord-band {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 22px 28px;
    border: 1px solid rgb(88 101 242 / 0.45);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 100% 50%, rgb(88 101 242 / 0.3), transparent 55%),
      var(--card);
  }
  .d-ico {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    background: #5865f2;
    color: #fff;
  }
  .d-text {
    flex: 1;
  }
  .d-text h2 {
    font-size: 1.3rem;
    margin: 0 0 4px;
  }
  .d-text p {
    margin: 0;
  }
  .discord-band .btn {
    flex-shrink: 0;
  }

  .how-head {
    text-align: center;
    margin-bottom: 28px;
  }
  .how-head h2 {
    margin: 0 0 6px;
  }
  .how-head p {
    margin: 0;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    counter-reset: none;
  }
  .step {
    position: relative;
    text-align: center;
    padding: 30px 22px 26px;
    background:
      radial-gradient(circle at 50% 0%, rgb(25 195 214 / 0.12), transparent 65%),
      var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  /* سهم يصل بين الخطوات (الصفحة من اليمين لليسار) */
  .step:not(:last-child)::after {
    content: '‹';
    position: absolute;
    top: 50%;
    left: -17px;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 1.4rem;
    line-height: 1;
    z-index: 1;
    /* حتى لا يقلب المتصفح اتجاه السهم في الصفحة العربية */
    direction: ltr;
    unicode-bidi: isolate;
  }
  .num {
    position: absolute;
    top: 14px;
    inset-inline-start: 16px;
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ico {
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    color: #0b0d17;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 10px 30px rgb(25 195 214 / 0.25);
  }
  .step h3 {
    font-size: 1.2rem;
    margin: 0 0 6px;
  }
  .step p {
    margin: 0;
  }
  @media (max-width: 800px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .step:not(:last-child)::after {
      content: '⌄';
      top: auto;
      bottom: -21px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 1.1rem;
    }
  }

  .articles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .article {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    transition: border-color 0.2s, transform 0.2s;
  }
  .article:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .article h3 {
    font-size: 1.2rem;
    margin: 4px 0 0;
  }
  .article p {
    margin: 0;
  }
  .article time {
    margin-top: auto;
    font-size: 0.85rem;
  }

  @media (max-width: 800px) {
    .articles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .discord-band {
      flex-direction: column;
      text-align: center;
      padding: 24px 20px;
    }
  }
  @media (max-width: 560px) {
    /* الجوال: بطاقتان في كل صف */
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .stats-strip {
      border-radius: var(--radius);
      gap: 8px 28px;
    }
    .stats-strip li + li::before {
      display: none;
    }
    .articles {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // عدد التحميلات الحقيقي من GitHub (عبر /api/downloads)
  const dlEl = document.getElementById('downloads-count');
  if (dlEl) {
    const offset = Number(dlEl.dataset.offset) || 0;
    const fmt = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
    fetch('/api/downloads')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then(({ total }) => (dlEl.textContent = fmt.format(total + offset)))
      .catch(() => (dlEl.textContent = offset ? fmt.format(offset) : '—'));
  }

  // زر "عرض المزيد": يُظهر دفعة جديدة من التعريبات عند كل ضغطة
  const moreBtn = document.getElementById('latest-more');
  const grid = document.getElementById('latest-cards');
  if (moreBtn && grid) {
    const size = Number(grid.dataset.pageSize) || 15;
    const hiddenCards = () => [...grid.querySelectorAll<HTMLElement>(':scope > [hidden]')];
    const countEl = document.getElementById('more-count');
    // عدّاد صغير تحت الزر: "7 تعريبات أخرى"
    const updateCount = () => {
      const n = hiddenCards().length;
      if (!countEl) return;
      countEl.textContent = n === 0 ? '' : n === 1 ? 'تعريب واحد آخر' : n === 2 ? 'تعريبان آخران' : n <= 10 ? `${n} تعريبات أخرى` : `${n} تعريباً آخر`;
    };
    // يُكمل الصف الأخير حسب عدد الأعمدة في شاشة الزائر (مثلاً 15 → 16 على الجوال)
    const fillRow = () => {
      const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
      const shown = grid.children.length - hiddenCards().length;
      const missing = (cols - (shown % cols)) % cols;
      hiddenCards()
        .slice(0, missing)
        .forEach((c) => (c.hidden = false));
      if (!hiddenCards().length) document.getElementById('more-wrap')?.remove();
      updateCount();
    };
    moreBtn.addEventListener('click', () => {
      hiddenCards()
        .slice(0, size)
        .forEach((c) => (c.hidden = false));
      fillRow();
    });
    fillRow();
  }

</script>
